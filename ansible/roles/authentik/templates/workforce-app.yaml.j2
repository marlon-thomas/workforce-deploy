            return True
  # After a password that wasn't checked (order 22): the /48 tightened and this source refused by it? (Its words.)
  - model: authentik_policies_expression.expressionpolicy
    id: wf-password-not-checked-network
    identifiers: { name: workforce-password-not-checked-network }
    attrs:
      name: workforce-password-not-checked-network
      expression: |
        # ---- the authentik part ----
        try:
            from authentik.policies.expression.models import ExpressionPolicy as WfShared
            wf_shared = dict()
            exec(WfShared.objects.get(name="workforce-sign-in-code").expression, wf_shared)
