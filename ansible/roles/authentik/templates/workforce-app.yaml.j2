version: 1
metadata:
  name: Care Angels Workforce application
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Default - Authentication flow
      required: false
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Default - Invalidation flow
      required: false
  - attrs:
      name: Workforce
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_id: {{ oidc_client_id }}
      client_secret: {{ oidc_client_secret }}
      # Without a signing_key the provider publishes an EMPTY JWKS and
      # every id_token fails validation ("no matching key(s) found").
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: user_email
      access_token_validity: hours=1
      refresh_token_validity: days=30
      # One list, typed entries (authentik 2026.x model): post-logout returns
      # are NOT a separate field — post_logout_redirect_uris is derived from
      # redirect_uris entries whose redirect_uri_type is 'logout'. A top-level
      # post_logout key is silently dropped by the serializer (same failure
      # mode as the old launch_url typo — caught live on the 2026.8 upgrade).
      redirect_uris:
        - matching_mode: strict
          url: https://{{ app_hostname }}/login/oauth2/code/oidc
        # RP-Initiated Logout (#14): Spring's handler returns to {baseUrl}/
        # after end-session; strict matching must allow exactly that.
        - matching_mode: strict
          redirect_uri_type: logout
          url: https://{{ app_hostname }}/
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
    identifiers:
      name: Workforce
    state: present
    model: authentik_providers_oauth2.oauth2provider
    id: workforce-provider
  - attrs:
      name: Workforce
      slug: workforce
      # The portal tile takes the user INTO the app (which starts the OIDC
      # flow properly) — a tile without a launch URL lands on the provider's
      # authorize endpoint without parameters: "Invalid credentials".
      # NOTE: the blueprint field is meta_launch_url (launch_url is silently
      # ignored by the serializer — verified against an empty DB column).
      meta_launch_url: https://{{ app_hostname }}
      provider: !KeyOf workforce-provider
    identifiers:
      slug: workforce
    state: present
    model: authentik_core.application
  - attrs:
      username: admin
      name: Administrator
      type: internal
      is_active: true
      # NOT acme_email: in certs-mode test installs that is the placeholder
      # 'local-ca@invalid', which authentik's serializer rejects — a rejected
      # entry aborts the whole blueprint import (provider never created).
      email: admin@{{ auth_hostname }}
      password: {{ ak_admin_password }}
    identifiers:
      username: admin
    state: created
    model: authentik_core.user
