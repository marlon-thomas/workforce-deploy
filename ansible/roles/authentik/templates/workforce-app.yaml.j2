    id: wf-code-step-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, default-authentication-mfa-validation]]
    attrs:
      order: 30
      evaluate_on_plan: false
      re_evaluate_policies: true
      # Review finding 7: authentik's default flow already binds its "optional" policy here, and with the default
      # mode (any) that one alone passes, so the emergency administrator was still asked for a code. All of them.
      policy_engine_mode: all
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-code-step-binding, policy: !KeyOf wf-not-emergency }
    attrs: { order: 0, enabled: true, failure_result: true }
  # authentik's own policy bound here by its default flow ("code step optional"; with this binding's mode "all" it
  # decides too): restated as its default blueprint has it, with the same guard as ours, so an error asks for the
  # code rather than skipping the step.
  - model: authentik_policies_expression.expressionpolicy
    identifiers: { name: default-authentication-flow-authenticator-validate-stage }
    attrs:
      name: default-authentication-flow-authenticator-validate-stage
      expression: |
        try:
            flow_plan = request.context.get("flow_plan")
            if not flow_plan:
                return True
            # if the authentication method is webauthn (passwordless), then we skip the authenticator
            # validation stage by returning false (true will execute the stage)
            return not (flow_plan.context.get("auth_method") == "auth_webauthn_pwl")
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="default-authentication-flow-authenticator-validate-stage",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
    state: present

  # Second security review (finding 6): the lock is checked on every password sent, not once per sign-in (see
  # wf-password-binding below), so a wrong password may be tried again on the same page, as authentik's default
  # has it (5; an earlier fix set 1, which made people start again after one typo). authentik validates the whole
  # stage on update, so its other fields are restated as its default blueprint has them.
  # Workforce issue 462 (seen on 2026.8.5): authentik counts this by the name's reputation score, which wrong passwords
  # for the name from any connection lower, so someone else's wrong passwords can end an open sign-in at its next typo
  # ("Invalid password"; start again). That is never a lock: the pause and the throttle above are what hold anyone.
  # Workforce issue 462 review of 15 November 2026 (finding 1): no TokenBackend. In 2026.8.5 it hashes the password
  # once more only for a name nobody has (core/auth.py: User().set_password), on top of InbuiltBackend's own one hash
  # for a missing user, so a wrong password for an unknown name took about 0.8 s longer than for a real account: an
  # oracle for which usernames and emails exist (owner's decision 2). Workforce uses no app passwords (its app's
  # account signs in with an API token, never through this stage). bin/tests/blueprint-test.sh keeps it out, and
  # authentik-lock-e2e.sh's L2 compares the times.
  - model: authentik_stages_password.passwordstage
    identifiers: { name: default-authentication-password }
    attrs:
      name: default-authentication-password
      backends:
        - authentik.core.auth.InbuiltBackend
        - authentik.sources.kerberos.auth.KerberosBackend
        - authentik.sources.ldap.auth.LDAPBackend
      configure_flow: !Find [authentik_flows.flow, [slug, default-password-change]]
      failed_attempts_before_cancel: 5
    state: present

  # A device stays signed in up to 30 days here; each organisation's own number of days (1 to 30, 7 unless
  # changed) is kept by Workforce from the token's auth_time, which sends the person back for a code sooner.
  - model: authentik_stages_user_login.userloginstage
    identifiers: { name: default-authentication-login }
    attrs:
      name: default-authentication-login
      session_duration: days=30
    state: present

  # No personal email given by Workforce yet: no code is sent anywhere, and the person is told to ask HR.
  # Evaluated when the stage is reached (after the password), so it says nothing about an account to someone
  # who doesn't know its password. akadmin, authentik's own superuser, has no stamp and so can't sign in here
  # at all (it never signs in to Workforce; the deployment works through `ak` inside the container).
  - model: authentik_policies_expression.expressionpolicy
    id: wf-codes-not-ready
    identifiers: { name: workforce-codes-not-ready }
    attrs:
      name: workforce-codes-not-ready
      expression: |
        try:
            user = request.context.get("pending_user")
            if user is None:
                return False
            # The emergency administrator gets no codes (ADR-0039 §5), so it isn't asked for an address either.
            if (user.username == "admin" and getattr(user, "type", "") == "internal" and not user.is_superuser
                    and not ak_is_group_member(user, name="authentik Admins")):
                return False
            wf = (user.attributes or {}).get("workforce") or {}
            codes = str(wf.get("codes") or "").strip().lower()
            return codes == "" or codes != str(user.email or "").strip().lower()
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-codes-not-ready",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
  - model: authentik_stages_deny.denystage
    id: wf-ask-hr
    identifiers: { name: workforce-ask-hr }
    attrs:
      name: workforce-ask-hr
      deny_message: >-
        We can’t send you a sign-in code yet, because there’s no personal email on your staff record.
        Please ask HR to add it, then try again.
  - model: authentik_flows.flowstagebinding
    id: wf-ask-hr-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-ask-hr
    attrs:
      order: 25
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-ask-hr-binding, policy: !KeyOf wf-codes-not-ready }
    attrs: { order: 0, enabled: true, failure_result: true }

  # ---------- Workforce issue 462 (ADR-0039, amendment of 14 November 2026, revised 15 November 2026): wrong passwords ----------
  # The private repo's docs/architecture/462-lockout-contract.md, section R. Nothing is ever locked for the whole
  # account, or for good.
  # - A source is the address authentik gives the request (the gateway decides it: no browser header can choose it):
  #   an IPv4 address, or an IPv6 address's /64. Not a TCP connection, a browser session, a page or a flow: every count
  #   is kept here under the source, so a new connection, cookie jar or page changes nothing.
  # - Pair (order 17): five wrong passwords for one name from one source within 15 minutes refuse that name there until
  #   15 minutes after the fifth. Every name alike, the emergency administrator included; an unknown name is counted
  #   exactly as a real one (authentik's "pretend the account exists"), under a keyed digest of the name, never the name.
  # - Source (order 15): ten wrong passwords from one source within 15 minutes, every name together (username, email,
  #   unknown, any spelling), refuse every name there until 15 minutes after the tenth. A workplace source (only one
  #   the operator confirmed in CLIENT_ADDRESSES_CONFIRMED; completed sign-ins never make one, the owner's Q3) has a
  #   higher cap, SIGN_IN_WORKPLACE_SOURCE_LIMIT (50 unless set; 20 to 100): never none.
  # - Network (order 16, IPv6): thirty wrong passwords from one /48 within 15 minutes (SIGN_IN_WORKPLACE_NETWORK_LIMIT,
  #   300 unless set, for a /48 holding a confirmed /48 to /63) tighten it: its unproven sources (nobody completed a
  #   sign-in there in 30 days, which is how /64s rotated through are stopped) and its abusive ones (5 or more wrong, no
  #   right) are refused; quiet, proven sources carry on (proven spares a source the tightening only: it is never a
  #   workplace). It ends 15 minutes after the newest counted try.
  # - Each try is recorded before the password is checked (custom_workforce_password_try), under PostgreSQL advisory
  #   locks on the source, its /48 and the pair, so requests at the same moment are taken one at a time; it counts as
  #   wrong until the flow reaches the step after the password (24), which marks it right. A refused request is never
  #   recorded, so it can't stretch any hold. A completed sign-in is recorded at 31 (custom_workforce_signed_in;
  #   before 99 and 100 re-check the password, so a sign-in refused there is still recorded: Workforce issue 494).
  # - Wrong passwords before the account's marker no longer count for its pairs: its last password change, or its last
  #   "Unlock sign-in" in Workforce, which only the sign-in status interface below records (custom_workforce_password_
  #   unlock, by this server's clock). No account attribute is read: the application's credential can write those.
  #   An unlock never touches a source or network hold.
  # - Alerts (custom_workforce_password_alert), never a lock: one source (or /48) trying five or more names within an
  #   hour; one account tried from three or more sources within an hour, or twenty wrong passwords in a day; a source
  #   held (throttled, workplace-throttled); a /48 tightened (network-tightened). Each at most once an hour.
  # The decision is ansible/roles/authentik/templates/password-pause.py (tested on its own by
  # bin/tests/password-pause-test.sh), kept once in workforce-sign-in-code below, and the whole thing runs on the pinned
  # authentik in bin/tests/authentik-lock-e2e.sh. Any error refuses (each policy's guard: see "Errors refuse" above).
  - model: authentik_policies_reputation.reputationpolicy
    identifiers: { name: workforce-too-many-tries }
    state: absent
  # The lock by account (and, for the emergency administrator, by account and address) that this replaces. Removing it
  # removes its bindings at 15, 20, 29 and 31 with it.
  - model: authentik_policies_expression.expressionpolicy
    identifiers: { name: workforce-too-many-tries-by-account }
    state: absent
  # The shared code (password-pause.py and code-tries.py, about 64 KB), kept ONCE (final review of the controller bundle,
  # findings 1 and 5). authentik 2026.8.5 runs each policy of a binding in the request's own thread and sends its result
  # down a pipe before anything reads it; that result (a pickled PolicyResult) carries the binding and so the policy's
  # whole expression, and one over 64 KiB blocks the thread for good: a sign-in that never answers, and a few dozen of
  # them leave authentik answering nobody. So no bound policy holds this code: each policy below that needs it loads it
  # by name as the first thing inside its guard (a missing or broken copy is an error there, which refuses), and its
  # own expression stays a few KB (bin/tests/blueprint-test.sh: 32 KiB at most; authentik-lock-e2e.sh measures the
  # pickled results live). This policy is bound nowhere, so authentik never runs it as a policy or sends it down a
  # pipe. It is the server's own code, under the same control as every other policy here: only authentik's admins can
  # change a policy.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-sign-in-code
    identifiers: { name: workforce-sign-in-code }
    attrs:
      name: workforce-sign-in-code
      execution_logging: false
      expression: |
{% filter indent(8, true) %}
{% include 'password-pause.py' %}
{% include 'code-tries.py' %}
{% endfilter %}
  # Orders 15, 16 and 17 (once a sign-in reaches them, after the name): the source held (15), the /48 tightened and this
  # source refused by it (16), the pair paused (17). Each has its own words (contract 3.8, R.6.5); the source's and the
  # network's win when they hold, since an unlock doesn't lift them. Decide only.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-password-throttled
    identifiers: { name: workforce-password-throttled }
    attrs:
      name: workforce-password-throttled
      expression: |
        # ---- the authentik part ----
        try:
            from authentik.policies.expression.models import ExpressionPolicy as WfShared
            wf_shared = dict()
            exec(WfShared.objects.get(name="workforce-sign-in-code").expression, wf_shared)
            globals().update((k, v) for k, v in wf_shared.items() if k[:3] in ("wf_", "WF_"))
            decision, http, person, account, conn, address, now = wf_ak_decide(request)
            return decision["source"] and wf_ak_refused(decision, address, person, account, conn, now)
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-password-throttled",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
  - model: authentik_policies_expression.expressionpolicy
    id: wf-network-tightened
    identifiers: { name: workforce-network-tightened }
    attrs:
      name: workforce-network-tightened
      expression: |
        # ---- the authentik part ----
        try:
            from authentik.policies.expression.models import ExpressionPolicy as WfShared
            wf_shared = dict()
            exec(WfShared.objects.get(name="workforce-sign-in-code").expression, wf_shared)
            globals().update((k, v) for k, v in wf_shared.items() if k[:3] in ("wf_", "WF_"))
            decision, http, person, account, conn, address, now = wf_ak_decide(request)
            return decision["rule"] == "network" and wf_ak_refused(decision, address, person, account, conn, now)
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-network-tightened",
                                  error=type(wf_error).__name__)
