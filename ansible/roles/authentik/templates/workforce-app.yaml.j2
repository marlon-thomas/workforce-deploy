            return True
  - model: authentik_policies_expression.expressionpolicy
    id: wf-password-paused
    identifiers: { name: workforce-password-paused }
    attrs:
      name: workforce-password-paused
      expression: |
        # ---- the authentik part ----
        try:
            from authentik.policies.expression.models import ExpressionPolicy as WfShared
            wf_shared = dict()
            exec(WfShared.objects.get(name="workforce-sign-in-code").expression, wf_shared)
            globals().update((k, v) for k, v in wf_shared.items() if k[:3] in ("wf_", "WF_"))
            decision, http, person, account, conn, address, now = wf_ak_decide(request)
            return decision["paused"] and wf_ak_refused(decision, address, person, account, conn, now)
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-password-paused",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
  # Order 20 (the password stage's binding, checked on every request to the stage): decides, and records a try when it
  # allows one, under one lock. The password stage runs only when this answers yes. It replaces workforce-password-try,
  # which answered the other way round and was bound negated, so that an error (which authentik turns into "fails")
  # came out as "may try" (review of issue 474, finding 2).
  - model: authentik_policies_expression.expressionpolicy
    identifiers: { name: workforce-password-try }
    state: absent
  - model: authentik_policies_expression.expressionpolicy
    id: wf-password-may-try
    identifiers: { name: workforce-password-may-try }
    attrs:
      name: workforce-password-may-try
      expression: |
        # ---- the authentik part ----
        try:
            from authentik.policies.expression.models import ExpressionPolicy as WfShared
            wf_shared = dict()
            exec(WfShared.objects.get(name="workforce-sign-in-code").expression, wf_shared)
            globals().update((k, v) for k, v in wf_shared.items() if k[:3] in ("wf_", "WF_"))
            from datetime import datetime, timezone as tz
            from uuid import uuid4
            from django.db import connections, transaction
            from django.utils import timezone
            from rest_framework.exceptions import ParseError
            http, person, account, conn, address = wf_ak_subject(request)
            pk = getattr(person, "pk", None)
            # The request as the password stage reads it: the same parsed request.data (never the raw body). If it can't be
            # parsed the stage can't read it either, and checks nothing. Anything else unexpected (no request.data at all)
            # raises, and the guard around this part answers no: the password isn't checked (closed).
            try:
                checked = wf_password_request(http.method, http.data)
            except ParseError:
                checked = False
            plan = request.context.get("flow_plan")
            if plan is not None:
                # Only the try this request records may be marked right at 22, never an earlier one of this sign-in.
                plan.context.pop(WF_PLAN_TRY, None)
            cfg = wf_ak_limits()
            if not checked:
                # A page load or an answer the stage won't check: decide only, record nothing.
                now = timezone.now().timestamp()
                events, markers = wf_ak_events(conn, account, person, now, False)
                return wf_decide(events, account, conn, markers, now, cfg)["rule"] is None
            # A proven source doesn't wait behind the /48's lock (wf_ak_try_locks; review of 15 November, findings 4, 15).
            proven = wf_ak_proven_now(conn, cfg, timezone.now().timestamp())
            with transaction.atomic(using="default"):
                with connections["default"].cursor() as cursor:
                    wf_ak_lock(cursor, *wf_ak_try_locks(account, conn, proven))
                now = timezone.now().timestamp()
                events, markers = wf_ak_events(conn, account, person, now, True)
                decision = wf_decide(events, account, conn, markers, now, cfg)
                if wf_ak_refused(decision, address, person, account, conn, now, locked=True):
                    return False
                tid = str(uuid4())
                wf_ak_record(WF_TRY, WF_KEEP_TRY, address, person, wf_try=tid, wf_account=account, wf_conn=conn,
                             wf_user_pk=pk)
                # A decision worked out earlier in this request no longer stands (wf_ak_decide).
                setattr(http, "_wf_decided", None)
                if plan is not None:
                    plan.context[WF_PLAN_TRY] = tid
                after = events + [{"at": now, "kind": "try", "try": tid, "account": account, "conn": conn, "pk": pk}]
                for alert in wf_spread(after, account, conn, pk, now, before=events, cfg=cfg):
                    field, value = wf_alert_key(alert)
                    if not wf_ak_rows(WF_ALERT, datetime.fromtimestamp(now - WF_ALERT_GAP, tz.utc),
                                      wf_kind=alert["wf_kind"], **{field: value}):
                        wf_ak_record(WF_ALERT, WF_KEEP_ALERT, address, None, **alert)
                return True
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-password-may-try",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return False
  # Order 24, reached only once the password stage has accepted the password: marks this sign-in's try right (with
  # wf_fwd: the gateway marked the request as forwarded by a peer nobody named, for the readiness check), then fails,
  # so its deny stage never shows.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-password-right
    identifiers: { name: workforce-password-right }
    attrs:
      name: workforce-password-right
      expression: |
        # ---- the authentik part ----
        try:
            from authentik.policies.expression.models import ExpressionPolicy as WfShared
            wf_shared = dict()
            exec(WfShared.objects.get(name="workforce-sign-in-code").expression, wf_shared)
            globals().update((k, v) for k, v in wf_shared.items() if k[:3] in ("wf_", "WF_"))
            from datetime import datetime, timezone as tz
            from django.db import connections, transaction
            from django.utils import timezone
            plan = request.context.get("flow_plan")
            if plan is None or not plan.context.get("user_backend"):
                return False
            http, person, account, conn, address = wf_ak_subject(request)
            pk = getattr(person, "pk", None)
            forwarded = http.META.get(WF_FORWARDED_HEADER, "") == "1"
            now = timezone.now().timestamp()
            tid = plan.context.get(WF_PLAN_TRY)
            found = wf_ak_rows(WF_TRY, datetime.fromtimestamp(now - WF_KEEP_TRY, tz.utc), wf_try=tid) if tid else []
            if found:
                ctx = found[0][1]
                account, conn = str(ctx.get("wf_account")), wf_connection_key(ctx.get("wf_conn"))
            with transaction.atomic(using="default"):
                with connections["default"].cursor() as cursor:
                    wf_ak_lock(cursor, (WF_LOCK_CONN, "conn:" + conn), (WF_LOCK_PAIR, "pair:" + account + "|" + conn))
                if not found:
                    # No try in the plan (or no longer kept): the pair's newest unmarked try of the last minute.
                    since = datetime.fromtimestamp(now - WF_RIGHT_FALLBACK, tz.utc)
                    rows = wf_ak_rows(WF_TRY, since, wf_account=account, wf_conn=conn)
                    marked = set(c.get("wf_try") for at, c in wf_ak_rows(WF_RIGHT, since, wf_account=account, wf_conn=conn))
                    rows = sorted([r for r in rows if r[1].get("wf_try") not in marked], key=lambda r: r[0])
                    if not rows:
                        return False
                    tid = rows[-1][1].get("wf_try")
                if not wf_ak_rows(WF_RIGHT, datetime.fromtimestamp(now - WF_KEEP_TRY, tz.utc), wf_try=tid):
                    wf_ak_record(WF_RIGHT, WF_KEEP_RIGHT, address, person, wf_try=tid, wf_account=account, wf_conn=conn,
                                 wf_user_pk=pk, wf_fwd=forwarded)
            plan.context.pop(WF_PLAN_TRY, None)
            return False
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-password-right",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
  # After a password that wasn't checked (order 21): the source held now? (Then its words; the network's are at 22;
  # otherwise the guard at 23 refuses with the pause's.)
  - model: authentik_policies_expression.expressionpolicy
