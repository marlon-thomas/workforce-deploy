                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
  # The words (contract 3.8): the same for a real name and one nobody has.
  - model: authentik_stages_deny.denystage
    id: wf-connection-throttled-stage
    identifiers: { name: workforce-connection-throttled }
    attrs:
      name: workforce-connection-throttled
      deny_message: >-
        Too many wrong passwords from this connection. Wait 15 minutes, or use another connection (for example your
        phone’s mobile data). Unlocking your sign-in doesn’t lift this.
  - model: authentik_stages_deny.denystage
    id: wf-network-tightened-stage
    identifiers: { name: workforce-network-tightened }
    attrs:
      name: workforce-network-tightened
      deny_message: >-
        Too many wrong passwords from this network. Wait 15 minutes, or use another connection (for example your
        workplace Wi-Fi or your phone’s mobile data). Unlocking your sign-in doesn’t lift this.
  - model: authentik_stages_deny.denystage
    id: wf-too-many-tries-stage
    identifiers: { name: workforce-too-many-tries }
    attrs:
      name: workforce-too-many-tries
      deny_message: >-
        Too many wrong passwords for this name, from this connection. Wait 15 minutes, then try again. If you’ve
        forgotten your password, use “Forgot your password?”. If you’re still stuck, ask your manager to unlock your
        sign-in.
  - model: authentik_flows.flowstagebinding
    id: wf-connection-throttled-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-connection-throttled-stage
    attrs:
      # Review finding 6: before the password (20), after the account is identified (10).
      order: 15
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-connection-throttled-binding, policy: !KeyOf wf-password-throttled }
    attrs: { order: 0, enabled: true, failure_result: true }
  - model: authentik_flows.flowstagebinding
    id: wf-network-tightened-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-network-tightened-stage
    attrs:
      order: 16
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-network-tightened-binding, policy: !KeyOf wf-network-tightened }
    attrs: { order: 0, enabled: true, failure_result: true }
  - model: authentik_flows.flowstagebinding
    id: wf-too-many-tries-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-too-many-tries-stage
    attrs:
      order: 17
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-too-many-tries-binding, policy: !KeyOf wf-password-paused }
    attrs: { order: 0, enabled: true, failure_result: true }

  # The password stage runs only while workforce-password-may-try and all of the binding's policies pass; it is
  # re-checked on every request to the stage (third review of finding 6), so many sign-ins opened at once can't each
  # take a password. A paused pair's password is never checked; the steps after (21, 23) then refuse. An error anywhere
  # in the policy, inside its guard or in authentik around it, is a no: the password isn't checked either.
  - model: authentik_flows.flowstagebinding
    id: wf-password-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !Find [authentik_stages_password.passwordstage, [name, default-authentication-password]]
    attrs:
      order: 20
      evaluate_on_plan: false
      re_evaluate_policies: true
      policy_engine_mode: all
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-password-binding, policy: !KeyOf wf-password-may-try }
    attrs: { order: 5, enabled: true, failure_result: false }
  # authentik's default flow binds its own policy here too ("password stage optional"): restated as its default
  # blueprint has it, with the same guard as ours, so an error asks for the password rather than skipping the step.
  - model: authentik_policies_expression.expressionpolicy
    identifiers: { name: default-authentication-flow-password-stage }
    attrs:
      name: default-authentication-flow-password-stage
      expression: |
        try:
            flow_plan = request.context.get("flow_plan")
            if not flow_plan:
                return True
            # If the user does not have a backend attached to it, they haven't
            # been authenticated yet and we need the password stage
            return not hasattr(flow_plan.context.get("pending_user"), "backend")
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="default-authentication-flow-password-stage",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
    state: present
  # Order 21: no password checked and the connection throttled: the throttle's words. (A stage is bound to a flow
  # once, so this is a second deny stage with the same words as at 15.) An error refuses here, with these words.
  - model: authentik_stages_deny.denystage
    id: wf-connection-throttled-after-stage
    identifiers: { name: workforce-connection-throttled-after }
    attrs:
      name: workforce-connection-throttled-after
      deny_message: >-
        Too many wrong passwords from this connection. Wait 15 minutes, or use another connection (for example your
        phone’s mobile data). Unlocking your sign-in doesn’t lift this.
  - model: authentik_flows.flowstagebinding
    id: wf-connection-throttled-after-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-connection-throttled-after-stage
    attrs:
      order: 21
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-connection-throttled-after-binding, policy: !KeyOf wf-password-not-checked-throttled }
    attrs: { order: 0, enabled: true, failure_result: true }
  # Order 22: no password checked and this source refused by its tightened /48: the network's words.
  - model: authentik_stages_deny.denystage
    id: wf-network-tightened-after-stage
    identifiers: { name: workforce-network-tightened-after }
    attrs:
      name: workforce-network-tightened-after
      deny_message: >-
        Too many wrong passwords from this network. Wait 15 minutes, or use another connection (for example your
        workplace Wi-Fi or your phone’s mobile data). Unlocking your sign-in doesn’t lift this.
  - model: authentik_flows.flowstagebinding
    id: wf-network-tightened-after-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-network-tightened-after-stage
    attrs:
      order: 22
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-network-tightened-after-binding, policy: !KeyOf wf-password-not-checked-network }
    attrs: { order: 0, enabled: true, failure_result: true }
  # Order 23: nothing goes past the password step without a password checked in this sign-in (authentik's password
  # stage records which backend accepted it). Decided by what happened, not by a count, so a pause that ends between
  # two checks can't let anyone through; an error refuses too.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-password-not-checked
    identifiers: { name: workforce-password-not-checked }
    attrs:
      name: workforce-password-not-checked
      expression: |
        try:
            plan = request.context.get("flow_plan")
            return plan is None or not plan.context.get("user_backend")
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-password-not-checked",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
  - model: authentik_stages_deny.denystage
    id: wf-password-not-checked-stage
    identifiers: { name: workforce-password-not-checked }
    attrs:
      name: workforce-password-not-checked
      deny_message: >-
        Too many wrong passwords for this name, from this connection. Wait 15 minutes, then try again. If you’ve
        forgotten your password, use “Forgot your password?”. If you’re still stuck, ask your manager to unlock your
        sign-in.
  - model: authentik_flows.flowstagebinding
    id: wf-password-not-checked-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-password-not-checked-stage
    attrs:
      order: 23
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-password-not-checked-binding, policy: !KeyOf wf-password-not-checked }
    attrs: { order: 0, enabled: true, failure_result: true }
  # Order 24 (22 until 15 November 2026): the try was right (workforce-password-right always fails, so this deny stage
  # never shows). After the guard at 23, which passes only once a password was checked.
  - model: authentik_stages_deny.denystage
    id: wf-password-right-stage
    identifiers: { name: workforce-password-right }
    attrs:
      name: workforce-password-right
      deny_message: >-
        Too many wrong passwords for this name, from this connection. Wait 15 minutes, then try again.
  - model: authentik_flows.flowstagebinding
    id: wf-password-right-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-password-right-stage
    attrs:
      order: 24
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-password-right-binding, policy: !KeyOf wf-password-right }
    attrs: { order: 0, enabled: true, failure_result: true }

  # Contract 2.3 (a): "what address does the sign-in server see?", for the readiness check ("client addresses" in
  # bin/doctor.sh, and the controller's probe). A flow anyone may open, with no stages, whose one policy always
  # refuses with workforce-client-address=<connection key>: authentik answers with its access-denied page carrying
  # that message. It reads and writes nothing about any account; it tells a caller only their own address.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-client-address-policy
    identifiers: { name: workforce-client-address }
    attrs:
      name: workforce-client-address
      expression: |
        # ---- the authentik part ----
        try:
            from authentik.policies.expression.models import ExpressionPolicy as WfShared
            wf_shared = dict()
            exec(WfShared.objects.get(name="workforce-sign-in-code").expression, wf_shared)
            globals().update((k, v) for k, v in wf_shared.items() if k[:3] in ("wf_", "WF_"))
            from authentik.root.middleware import ClientIPMiddleware
            ak_message("workforce-client-address=" + wf_connection_key(ClientIPMiddleware.get_client_ip(request.http_request)))
            return False
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-client-address",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return False
  - model: authentik_flows.flow
    id: wf-client-address-flow
    identifiers: { slug: workforce-client-address }
    attrs:
      name: Workforce client address check
      slug: workforce-client-address
      title: Client address check
      designation: stage_configuration
      authentication: none
      denied_action: message
      layout: stacked
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-client-address-flow, policy: !KeyOf wf-client-address-policy }
    attrs: { order: 0, enabled: true }

  # Workforce issue 462 (contract R.7, 15 November 2026): the sign-in status interface's code. Bound to nothing, so it
  # never takes part in a sign-in; it runs only as the property mapping workforce-sign-in-status, which
  # invite-service-account.py makes from this text after every apply (authentik's blueprints can't make that kind of
  # mapping) and which only the application's service account may test (object permissions on that one mapping). It
  # answers that account alone, for one person: paused or not (from the records only this server writes, never an
  # attribute the application could write), an unlock (recorded with this server's clock, its id used once), whether
  # an unlock was applied (an id asked about before it was applied is voided), and the attack alerts. Nothing else:
  # no email, code, link, typed name or other event. Run any other way (a test of this policy, by anyone) it answers
  # nothing. The sign-in decisions above never read anything it writes except the unlock record, and never depend on
  # it answering.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-sign-in-status-code
    identifiers: { name: workforce-sign-in-status-code }
    attrs:
      name: workforce-sign-in-status-code
      execution_logging: false
      expression: |
        # ---- the authentik part ----
        try:
            from authentik.policies.expression.models import ExpressionPolicy as WfShared
            wf_shared = dict()
            exec(WfShared.objects.get(name="workforce-sign-in-code").expression, wf_shared)
            globals().update((k, v) for k, v in wf_shared.items() if k[:3] in ("wf_", "WF_"))
            return wf_ak_status_answer(request)
        except Exception:
            return {"v": 1, "known": False, "why": "error"}

  # My Hub → "Use an authenticator app" opens this (signed in already): an email code first, so only the person
  # who reads that email can add an app, then the app's QR code. Workforce then removes the email method when they
  # press Finish, and puts it back if they switch back (both from My Hub).
  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    id: wf-confirm-by-email
    identifiers: { name: workforce-confirm-by-email }
    attrs:
      name: workforce-confirm-by-email
      device_classes: [email]
      not_configured_action: deny
      last_auth_threshold: seconds=0
      webauthn_user_verification: preferred
  - model: authentik_flows.flow
    id: wf-authenticator-app-flow
    identifiers: { slug: workforce-authenticator-app }
    attrs:
      name: Workforce authenticator app
      slug: workforce-authenticator-app
      title: Use an authenticator app
      designation: stage_configuration
      authentication: require_authenticated
      layout: stacked
  - model: authentik_flows.flowstagebinding
    identifiers: { target: !KeyOf wf-authenticator-app-flow, stage: !KeyOf wf-confirm-by-email }
    attrs: { order: 10 }
  - model: authentik_flows.flowstagebinding
    identifiers: { target: !KeyOf wf-authenticator-app-flow, stage: !KeyOf wf-authenticator-app }
    attrs: { order: 20 }

  # ADR-0039 review: only the page above (an email code first) can add an authenticator app. authentik's own
  # set-up pages (an app, recovery codes, a security key) would let any signed-in session add one with no code,
  # so they refuse everyone, and the default app and recovery-code stages no longer offer them on authentik's
  # account page. (authentik's default blueprints are re-applied only when their files change.)
  - model: authentik_policies_expression.expressionpolicy
    id: wf-nobody
    identifiers: { name: workforce-nobody }
    attrs:
      name: workforce-nobody
      expression: |
        try:
            ak_message("Add an authenticator app from Workforce: My record, then Signing in.")
            return False
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-nobody",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return False
  # Each page is named here by `!KeyOf` (state: created, so authentik's own settings for it are left alone), because a
  # policy binding's target is the flow's binding model, not the flow: `!Find` gives the flow's own id, which finds no
  # binding once there is one, so applying the blueprint again tried to make a second and failed ("policy, target, order
  # must make a unique set"; Workforce issue 453, found on a fresh authentik 2026.8.5).
{% for slug in ['default-authenticator-totp-setup', 'default-authenticator-static-setup', 'default-authenticator-webauthn-setup'] %}
  - model: authentik_flows.flow
    id: wf-locked-{{ slug }}
    identifiers: { slug: {{ slug }} }
    state: created
    attrs: { name: {{ slug }}, slug: {{ slug }}, title: {{ slug }}, designation: stage_configuration, authentication: require_authenticated }
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf wf-locked-{{ slug }}
      policy: !KeyOf wf-nobody
    attrs: { order: 0, enabled: true }
{% endfor %}
  # Second review of the controller bundle (finding 6): authentik's own change-password page (its account page's
  # "Change password", and the password stage's configure_flow above) has authentik's rule, 8 characters, so it
  # would bypass wf-emergency-password. It refuses the emergency administrator, which changes its password from
  # Workforce's account menu (workforce-password-change) instead; everyone else may still use it.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-emergency-not-here
    identifiers: { name: workforce-emergency-password-not-here }
    attrs:
      name: workforce-emergency-password-not-here
      expression: |
        try:
            user = request.user
            emergency = (user.username == "admin" and getattr(user, "type", "") == "internal" and not user.is_superuser
                         and not ak_is_group_member(user, name="authentik Admins"))
            if emergency:
                ak_message("Change this account's password from Workforce's account menu: Change password.")
            return not emergency
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-emergency-password-not-here",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return False
  - model: authentik_flows.flow
    id: wf-default-password-change
    identifiers: { slug: default-password-change }
    state: created
    attrs: { name: Change Password, slug: default-password-change, title: Change password, designation: stage_configuration, authentication: require_authenticated }
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf wf-default-password-change
      policy: !KeyOf wf-emergency-not-here
    attrs: { order: 0, enabled: true }
  - model: authentik_stages_authenticator_totp.authenticatortotpstage
    identifiers: { name: default-authenticator-totp-setup }
    attrs:
      name: default-authenticator-totp-setup
      friendly_name: TOTP Device
      digits: 6
      configure_flow: null
    state: present
  - model: authentik_stages_authenticator_static.authenticatorstaticstage
    identifiers: { name: default-authenticator-static-setup }
    attrs:
      name: default-authenticator-static-setup
      friendly_name: Static tokens
      token_count: 6
      configure_flow: null
    state: present


  # ADR-0039 §5 (review finding 31): the emergency administrator's own "add an authenticator app" page. No email
  # code first (it has none): signed in already, with its password. Only that account may open it.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-only-emergency
    identifiers: { name: workforce-only-the-emergency-administrator }
    attrs:
      name: workforce-only-the-emergency-administrator
      expression: |
        try:
            user = request.user
            return (user.username == "admin" and getattr(user, "type", "") == "internal" and not user.is_superuser
                    and not ak_is_group_member(user, name="authentik Admins"))
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-only-the-emergency-administrator",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return False
  - model: authentik_flows.flow
    id: wf-emergency-app-flow
    identifiers: { slug: workforce-emergency-authenticator-app }
    attrs:
      name: Workforce emergency administrator authenticator app
      slug: workforce-emergency-authenticator-app
      title: Add an authenticator app
      designation: stage_configuration
      authentication: require_authenticated
      layout: stacked
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-emergency-app-flow, policy: !KeyOf wf-only-emergency }
    attrs: { order: 0, enabled: true }
  - model: authentik_flows.flowstagebinding
    identifiers: { target: !KeyOf wf-emergency-app-flow, stage: !KeyOf wf-authenticator-app }
    attrs: { order: 10 }

  # Workforce issue 462 (contract 3.7): wrong codes keep their own count, by account, apart from wrong passwords and
  # the "Send a new code" limit: five wrong codes within 15 minutes, then a 15-minute wait from the fifth (only someone
  # with the password reaches the code step). code-tries.py has the rule; bin/tests/authentik-lock-e2e.sh runs it.
  # - workforce-code-try, on the code step's binding, records each code typed in (custom_workforce_code_try), unless
  #   the account's codes are paused (then nothing is recorded, so the wait isn't stretched). It always passes: the code
  #   step is never skipped because of it (its failure result is true too).
  # - workforce-codes-paused, before the code step (29) and after it (31): at 31 it first marks this sign-in's code
  #   try right (the code step accepted it), then decides. After five wrong codes even a right one doesn't sign in.
  # An unlock in Workforce doesn't touch it.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-code-try
    identifiers: { name: workforce-code-try }
    attrs:
      name: workforce-code-try
      expression: |
        # ---- the authentik part ----
        try:
            from authentik.policies.expression.models import ExpressionPolicy as WfShared
            wf_shared = dict()
            exec(WfShared.objects.get(name="workforce-sign-in-code").expression, wf_shared)
            globals().update((k, v) for k, v in wf_shared.items() if k[:3] in ("wf_", "WF_"))
            from datetime import datetime, timezone as tz
            from uuid import uuid4
            from django.db import connections, transaction
            from django.utils import timezone
            from rest_framework.exceptions import ParseError
            http, person, account, conn, address = wf_ak_subject(request)
            pk = getattr(person, "pk", None)
            plan = request.context.get("flow_plan")
            if pk is None or plan is None:
                return True
            # Only a code this request records may be marked right at 31: never one typed earlier in this sign-in (a wrong
            # one, or one typed while the codes were paused, which is recorded nowhere).
            plan.context.pop(WF_PLAN_CODE_TRY, None)
            offered = [c.get("device_class") for c in (plan.context.get(
                "goauthentik.io/stages/authenticator_validate/device_challenges") or []) if isinstance(c, dict)]
            try:
                checked = wf_code_request(http.method, http.data, offered)
            except ParseError:
                checked = False
            if not checked:
                return True
            with transaction.atomic(using="default"):
                with connections["default"].cursor() as cursor:
                    wf_ak_lock(cursor, (WF_LOCK_CODES, "codes:%d" % int(pk)), (WF_LOCK_CODES, None))
                now = timezone.now().timestamp()
                since = datetime.fromtimestamp(now - 2 * WF_WINDOW, tz.utc)
                tries = [(at, c.get("wf_try")) for at, c in wf_ak_rows(WF_CODE_TRY, since, wf_user_pk=int(pk))]
                right = set(c.get("wf_try") for at, c in wf_ak_rows(WF_CODE_RIGHT, since, wf_user_pk=int(pk)))
                if wf_codes_paused(tries, right, now) is not None:
                    return True
                tid = str(uuid4())
                wf_ak_record(WF_CODE_TRY, WF_CODE_KEEP, address, wf_try=tid, wf_user_pk=int(pk))
                plan.context[WF_PLAN_CODE_TRY] = tid
            return True
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-code-try",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-code-step-binding, policy: !KeyOf wf-code-try }
    attrs: { order: 3, enabled: true, failure_result: true }
  - model: authentik_policies_expression.expressionpolicy
    id: wf-codes-paused
    identifiers: { name: workforce-codes-paused }
    attrs:
      name: workforce-codes-paused
      expression: |
        # ---- the authentik part ----
        try:
            from authentik.policies.expression.models import ExpressionPolicy as WfShared
            wf_shared = dict()
            exec(WfShared.objects.get(name="workforce-sign-in-code").expression, wf_shared)
            globals().update((k, v) for k, v in wf_shared.items() if k[:3] in ("wf_", "WF_"))
            from datetime import datetime, timezone as tz
            from django.db import connections, transaction
            from django.utils import timezone
            http, person, account, conn, address = wf_ak_subject(request)
            pk = getattr(person, "pk", None)
            if pk is None:
                return False
            plan = request.context.get("flow_plan")
            with transaction.atomic(using="default"):
                with connections["default"].cursor() as cursor:
                    wf_ak_lock(cursor, (WF_LOCK_CODES, "codes:%d" % int(pk)), (WF_LOCK_CODES, None))
                now = timezone.now().timestamp()
                since = datetime.fromtimestamp(now - 2 * WF_WINDOW, tz.utc)
                tries = [(at, c.get("wf_try")) for at, c in wf_ak_rows(WF_CODE_TRY, since, wf_user_pk=int(pk))]
                right = set(c.get("wf_try") for at, c in wf_ak_rows(WF_CODE_RIGHT, since, wf_user_pk=int(pk)))
                tid = plan.context.pop(WF_PLAN_CODE_TRY, None) if plan is not None else None
                marked = False
                if tid and tid in set(t for at, t in tries) and tid not in right:
                    # Only reached at 31, after the code step accepted this code (at 29 no code has been typed yet).
                    wf_ak_record(WF_CODE_RIGHT, WF_CODE_KEEP, address, wf_try=tid, wf_user_pk=int(pk))
                    right.add(tid)
                    marked = True
                paused = wf_codes_paused(tries, right, now) is not None
                if marked and not paused and wf_signs_in(person, plan):
                    # A completed sign-in (contract R.2): the right password (23 let it past) and now the right code. It
                    # makes this source proven (spared its /48's tightening; its address shown to this person's
                    # organisation in alerts, the owner's Q5), never a workplace (only the operator's list makes one, Q3).
                    wf_ak_record(WF_SIGNED, WF_KEEP_SIGNED, address, person, wf_user_pk=int(pk), wf_conn=conn)
            return paused
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-codes-paused",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
  - model: authentik_stages_deny.denystage
    id: wf-too-many-tries-codes
    identifiers: { name: workforce-too-many-tries-codes }
    attrs:
      name: workforce-too-many-tries-codes
      deny_message: >-
        That code was wrong too many times. Wait 15 minutes, then sign in again, and we’ll send you a new code.
  - model: authentik_flows.flowstagebinding
    id: wf-too-many-tries-codes-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-too-many-tries-codes
    attrs:
      order: 29
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-too-many-tries-codes-binding, policy: !KeyOf wf-codes-paused }
    attrs: { order: 0, enabled: true, failure_result: true }

  # Third review of finding 6: the code step asks again in place, so the check at 29 isn't seen again. It is checked
  # once more after the code: after too many wrong codes, even a right code doesn't sign anyone in. (Not a lock on the
  # code step itself: a skipped code step would sign in without a code.)
  - model: authentik_stages_deny.denystage
    id: wf-too-many-tries-after-code
    identifiers: { name: workforce-too-many-tries-after-code }
    attrs:
      name: workforce-too-many-tries-after-code
      deny_message: >-
        That code was wrong too many times. Wait 15 minutes, then sign in again, and we’ll send you a new code.
  - model: authentik_flows.flowstagebinding
    id: wf-too-many-tries-after-code-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-too-many-tries-after-code
    attrs:
      order: 31
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-too-many-tries-after-code-binding, policy: !KeyOf wf-codes-paused }
    attrs: { order: 0, enabled: true, failure_result: true }

  # ---------- Workforce issue 474: a sign-in in progress can't outlive a password change ----------
  # The password is checked at 20 and the person signed in at 100, one or more requests later. A sign-in held in
  # between used to finish after the password was replaced (by the person, a reset link, an operator, reset-admin.sh
  # or the controller's first password, Workforce issue 463). The rule is password-unchanged.py (tested on its own by
  # bin/tests/password-pause-test.sh); bin/tests/authentik-lock-e2e.sh holds real sign-ins while the password changes.
  # - 24, workforce-password-seen: records in the flow plan what the password stage checked (a digest of the hash of
  #   the account its backend returned, which the stage put in the plan; never re-read from the database). Bound on the
  #   24 binding beside workforce-password-right; it always fails, so that deny stage never shows. Before the code step
  #   (30), the only stage that could replace the plan's account. An error refuses there and then (its guard answers
  #   yes, which shows the deny stage); had it left no record anyway, 99 and 100 would refuse.
  # - 99, workforce-password-replaced: just before the login, compares that record with the account's hash now, and
  #   refuses on any difference (or no record, or the account gone or inactive) with authentik's words for a wrong
  #   password, whatever the reason, so the page says nothing a wrong password wouldn't. Evaluated in the same request
  #   as the login (authentik runs the next stages' re-checks one after another until a stage answers); an error
  #   refuses.
  # - 100, the login step's own binding: workforce-password-unchanged, the same comparison answered the other way round
  #   (never the policy above negated: authentik turns an error into "fails", which negated would sign the person in),
  #   re-checked when the login is reached (a last check, for a login step that would ever wait for an answer, such as
  #   "remember me"). Only a yes runs the login step: no record, a difference or any error skips it and nobody is
  #   signed in. The 99 deny stage normally refuses first, with words.
  # Each refuses on an error of its own: 24 and 99 by their guards (an error is a yes, which shows their deny stage),
  # 100 by answering no, inside its guard or not. An error authentik itself raises around a deny stage's policy, before
  # the policy's own code runs, still counts as "fails" there and can't be caught here; 100 is the check that holds then.
  # Every account alike, the emergency administrator included. Neither enrolment nor a password reset signs anyone in
  # (finding 1 above), so the ordinary sign-in is the only flow here that ends in a login after a password.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-password-seen
    identifiers: { name: workforce-password-seen }
    attrs:
      name: workforce-password-seen
      expression: |
{% filter indent(8, true) %}
{% include 'password-unchanged.py' %}
{% endfilter %}
        # ---- the authentik part ----
        try:
            plan = request.context.get("flow_plan")
            if plan is None or not plan.context.get("user_backend") or WF_PLAN_SEEN in plan.context:
                return False
            # The account authentik's backend returned at the password step (password stage: pending_user), as kept in
            # the flow plan since: its hash is the one the step checked, whatever the database holds now.
            person = plan.context.get("pending_user")
            seen = wf_password_seen(getattr(person, "pk", None), getattr(person, "password", None),
                                    plan.context.get("user_backend"))
            if seen is not None:
                plan.context[WF_PLAN_SEEN] = seen
            return False
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-password-seen",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-password-right-binding, policy: !KeyOf wf-password-seen }
    attrs: { order: 1, enabled: true, failure_result: true }
  - model: authentik_policies_expression.expressionpolicy
    id: wf-password-replaced
    identifiers: { name: workforce-password-replaced }
    attrs:
      name: workforce-password-replaced
      expression: |
{% filter indent(8, true) %}
{% include 'password-unchanged.py' %}
{% endfilter %}
        # ---- the authentik part ----
        try:
            from authentik.core.models import User
            plan = request.context.get("flow_plan")
            if plan is None:
                return True
            seen = plan.context.get(WF_PLAN_SEEN)
            pending_pk = getattr(plan.context.get("pending_user"), "pk", None)
            current = None
            if isinstance(seen, dict) and isinstance(seen.get("pk"), int):
                # The primary database (never a read replica, which could still hold the old hash).
                current = User.objects.using("default").filter(pk=seen["pk"]).values_list("pk", "password", "is_active").first()
            return wf_password_replaced(seen, pending_pk, current) is not None
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-password-replaced",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return True
  - model: authentik_stages_deny.denystage
    id: wf-password-replaced-stage
    identifiers: { name: workforce-password-replaced }
    attrs:
      name: workforce-password-replaced
      deny_message: >-
        Invalid password. Please sign in again.
  - model: authentik_flows.flowstagebinding
    id: wf-password-replaced-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-password-replaced-stage
    attrs:
      order: 99
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-password-replaced-binding, policy: !KeyOf wf-password-replaced }
    attrs: { order: 0, enabled: true, failure_result: true }
  # authentik's own login binding (100, as its default flow has it), now re-checked when it is reached.
  - model: authentik_flows.flowstagebinding
    id: wf-login-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !Find [authentik_stages_user_login.userloginstage, [name, default-authentication-login]]
    attrs:
      order: 100
      evaluate_on_plan: false
      re_evaluate_policies: true
      policy_engine_mode: all
  # The negated binding this replaces (review of issue 474, finding 1).
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-login-binding, policy: !KeyOf wf-password-replaced }
    state: absent
  - model: authentik_policies_expression.expressionpolicy
    id: wf-password-unchanged
    identifiers: { name: workforce-password-unchanged }
    attrs:
      name: workforce-password-unchanged
      expression: |
{% filter indent(8, true) %}
{% include 'password-unchanged.py' %}
{% endfilter %}
        # ---- the authentik part ----
        try:
            from authentik.core.models import User
            plan = request.context.get("flow_plan")
            if plan is None:
                return False
            seen = plan.context.get(WF_PLAN_SEEN)
            pending_pk = getattr(plan.context.get("pending_user"), "pk", None)
            current = None
            if isinstance(seen, dict) and isinstance(seen.get("pk"), int):
                # The primary database (never a read replica, which could still hold the old hash).
                current = User.objects.using("default").filter(pk=seen["pk"]).values_list("pk", "password", "is_active").first()
            return wf_password_replaced(seen, pending_pk, current) is None
        except Exception as wf_error:
            try:
                ak_logger.warning("workforce: an error in a sign-in policy, so it refuses", policy="workforce-password-unchanged",
                                  error=type(wf_error).__name__)
            except Exception:
                pass
            return False
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-login-binding, policy: !KeyOf wf-password-unchanged }
    attrs: { order: 1, enabled: true, failure_result: false }

  # Second security review (finding 1): authentik's first-run page (initial-setup) sets akadmin's password with no
  # code. The flow itself is closed, as authentik closes it after its own setup: only a superuser may run it, and
  # every policy bound to it must pass. (A flow needs ANY of its policies by default, and authentik's own
  # default-oobe-password-usable passes on a fresh install, so a refusing policy alone did nothing: third review.)
  # Name, title and designation are restated as authentik's first-run blueprint has them, so this works whichever
  # of the two runs first. The gateway doesn't route the page and sign-in-hardening.py sets authentik's Setup flag.
  - model: authentik_flows.flow
    id: wf-first-run-flow
    identifiers: { slug: initial-setup }
    attrs:
      name: default-oobe-setup
      title: Welcome to authentik!
      designation: stage_configuration
      denied_action: message_continue
      authentication: require_superuser
      policy_engine_mode: all
    state: present
  - model: authentik_policies_expression.expressionpolicy
    id: wf-no-first-run
    identifiers: { name: workforce-no-first-run-page }
    attrs:
      name: workforce-no-first-run-page
      expression: |
        return False
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf wf-first-run-flow
      policy: !KeyOf wf-no-first-run
    attrs: { order: 0, enabled: true }
