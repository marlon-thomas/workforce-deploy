  # it answering.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-sign-in-status-code
    identifiers: { name: workforce-sign-in-status-code }
    attrs:
      name: workforce-sign-in-status-code
      execution_logging: false
      expression: |
{% filter indent(8, true) %}
{% include 'password-pause.py' %}
{% endfilter %}
        # ---- the authentik part ----
        try:
            return wf_ak_status_answer(request)
        except Exception:
            return {"v": 1, "known": False, "why": "error"}

  # My Hub → "Use an authenticator app" opens this (signed in already): an email code first, so only the person
  # who reads that email can add an app, then the app's QR code. Workforce then removes the email method when they
  # press Finish, and puts it back if they switch back (both from My Hub).
  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    id: wf-confirm-by-email
    identifiers: { name: workforce-confirm-by-email }
    attrs:
      name: workforce-confirm-by-email
      device_classes: [email]
      not_configured_action: deny
      last_auth_threshold: seconds=0
      webauthn_user_verification: preferred
  - model: authentik_flows.flow
    id: wf-authenticator-app-flow
    identifiers: { slug: workforce-authenticator-app }
    attrs:
      name: Workforce authenticator app
      slug: workforce-authenticator-app
      title: Use an authenticator app
      designation: stage_configuration
      authentication: require_authenticated
      layout: stacked
  - model: authentik_flows.flowstagebinding
    identifiers: { target: !KeyOf wf-authenticator-app-flow, stage: !KeyOf wf-confirm-by-email }
    attrs: { order: 10 }
  - model: authentik_flows.flowstagebinding
    identifiers: { target: !KeyOf wf-authenticator-app-flow, stage: !KeyOf wf-authenticator-app }
    attrs: { order: 20 }

  # ADR-0039 review: only the page above (an email code first) can add an authenticator app. authentik's own
  # set-up pages (an app, recovery codes, a security key) would let any signed-in session add one with no code,
  # so they refuse everyone, and the default app and recovery-code stages no longer offer them on authentik's
  # account page. (authentik's default blueprints are re-applied only when their files change.)
  - model: authentik_policies_expression.expressionpolicy
    id: wf-nobody
    identifiers: { name: workforce-nobody }
    attrs:
      name: workforce-nobody
      expression: |
        ak_message("Add an authenticator app from Workforce: My record, then Signing in.")
        return False
  # Each page is named here by `!KeyOf` (state: created, so authentik's own settings for it are left alone), because a
  # policy binding's target is the flow's binding model, not the flow: `!Find` gives the flow's own id, which finds no
  # binding once there is one, so applying the blueprint again tried to make a second and failed ("policy, target, order
  # must make a unique set"; Workforce issue 453, found on a fresh authentik 2026.8.5).
{% for slug in ['default-authenticator-totp-setup', 'default-authenticator-static-setup', 'default-authenticator-webauthn-setup'] %}
  - model: authentik_flows.flow
    id: wf-locked-{{ slug }}
    identifiers: { slug: {{ slug }} }
    state: created
    attrs: { name: {{ slug }}, slug: {{ slug }}, title: {{ slug }}, designation: stage_configuration, authentication: require_authenticated }
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf wf-locked-{{ slug }}
      policy: !KeyOf wf-nobody
    attrs: { order: 0, enabled: true }
{% endfor %}
  # Second review of the controller bundle (finding 6): authentik's own change-password page (its account page's
  # "Change password", and the password stage's configure_flow above) has authentik's rule, 8 characters, so it
  # would bypass wf-emergency-password. It refuses the emergency administrator, which changes its password from
  # Workforce's account menu (workforce-password-change) instead; everyone else may still use it.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-emergency-not-here
    identifiers: { name: workforce-emergency-password-not-here }
    attrs:
      name: workforce-emergency-password-not-here
      expression: |
        user = request.user
        emergency = (user.username == "admin" and getattr(user, "type", "") == "internal" and not user.is_superuser
                     and not ak_is_group_member(user, name="authentik Admins"))
        if emergency:
            ak_message("Change this account's password from Workforce's account menu: Change password.")
        return not emergency
  - model: authentik_flows.flow
    id: wf-default-password-change
    identifiers: { slug: default-password-change }
    state: created
    attrs: { name: Change Password, slug: default-password-change, title: Change password, designation: stage_configuration, authentication: require_authenticated }
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf wf-default-password-change
      policy: !KeyOf wf-emergency-not-here
    attrs: { order: 0, enabled: true }
  - model: authentik_stages_authenticator_totp.authenticatortotpstage
    identifiers: { name: default-authenticator-totp-setup }
    attrs:
      name: default-authenticator-totp-setup
      friendly_name: TOTP Device
      digits: 6
      configure_flow: null
    state: present
  - model: authentik_stages_authenticator_static.authenticatorstaticstage
    identifiers: { name: default-authenticator-static-setup }
    attrs:
      name: default-authenticator-static-setup
      friendly_name: Static tokens
      token_count: 6
      configure_flow: null
    state: present


  # ADR-0039 §5 (review finding 31): the emergency administrator's own "add an authenticator app" page. No email
  # code first (it has none): signed in already, with its password. Only that account may open it.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-only-emergency
    identifiers: { name: workforce-only-the-emergency-administrator }
    attrs:
      name: workforce-only-the-emergency-administrator
      expression: |
        user = request.user
        return (user.username == "admin" and getattr(user, "type", "") == "internal" and not user.is_superuser
                and not ak_is_group_member(user, name="authentik Admins"))
  - model: authentik_flows.flow
    id: wf-emergency-app-flow
    identifiers: { slug: workforce-emergency-authenticator-app }
    attrs:
      name: Workforce emergency administrator authenticator app
      slug: workforce-emergency-authenticator-app
      title: Add an authenticator app
      designation: stage_configuration
      authentication: require_authenticated
      layout: stacked
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-emergency-app-flow, policy: !KeyOf wf-only-emergency }
    attrs: { order: 0, enabled: true }
  - model: authentik_flows.flowstagebinding
    identifiers: { target: !KeyOf wf-emergency-app-flow, stage: !KeyOf wf-authenticator-app }
    attrs: { order: 10 }

  # Workforce issue 462 (contract 3.7): wrong codes keep their own count, by account, apart from wrong passwords and
  # the "Send a new code" limit: five wrong codes within 15 minutes, then a 15-minute wait from the fifth (only someone
  # with the password reaches the code step). code-tries.py has the rule; bin/tests/authentik-lock-e2e.sh runs it.
  # - workforce-code-try, on the code step's binding, records each code typed in (custom_workforce_code_try), unless
  #   the account's codes are paused (then nothing is recorded, so the wait isn't stretched). It always passes: the code
  #   step is never skipped because of it (its failure result is true too).
  # - workforce-codes-paused, before the code step (29) and after it (31): at 31 it first marks this sign-in's code
  #   try right (the code step accepted it), then decides. After five wrong codes even a right one doesn't sign in.
  # An unlock in Workforce doesn't touch it.
  - model: authentik_policies_expression.expressionpolicy
    id: wf-code-try
    identifiers: { name: workforce-code-try }
    attrs:
      name: workforce-code-try
      expression: |
{% filter indent(8, true) %}
{% include 'password-pause.py' %}
{% include 'code-tries.py' %}
{% endfilter %}
        # ---- the authentik part ----
        from datetime import datetime, timezone as tz
        from uuid import uuid4
        from django.db import connections, transaction
        from django.utils import timezone
        from rest_framework.exceptions import ParseError
        http, person, account, conn, address = wf_ak_subject(request)
        pk = getattr(person, "pk", None)
        plan = request.context.get("flow_plan")
        if pk is None or plan is None:
            return True
        # Only a code this request records may be marked right at 31: never one typed earlier in this sign-in (a wrong
        # one, or one typed while the codes were paused, which is recorded nowhere).
        plan.context.pop(WF_PLAN_CODE_TRY, None)
        offered = [c.get("device_class") for c in (plan.context.get(
            "goauthentik.io/stages/authenticator_validate/device_challenges") or []) if isinstance(c, dict)]
        try:
            checked = wf_code_request(http.method, http.data, offered)
        except ParseError:
            checked = False
        if not checked:
            return True
        with transaction.atomic(using="default"):
            with connections["default"].cursor() as cursor:
                wf_ak_lock(cursor, (WF_LOCK_CODES, "codes:%d" % int(pk)), (WF_LOCK_CODES, None))
            now = timezone.now().timestamp()
            since = datetime.fromtimestamp(now - 2 * WF_WINDOW, tz.utc)
            tries = [(at, c.get("wf_try")) for at, c in wf_ak_rows(WF_CODE_TRY, since, wf_user_pk=int(pk))]
            right = set(c.get("wf_try") for at, c in wf_ak_rows(WF_CODE_RIGHT, since, wf_user_pk=int(pk)))
            if wf_codes_paused(tries, right, now) is not None:
                return True
            tid = str(uuid4())
            wf_ak_record(WF_CODE_TRY, WF_CODE_KEEP, address, wf_try=tid, wf_user_pk=int(pk))
            plan.context[WF_PLAN_CODE_TRY] = tid
        return True
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-code-step-binding, policy: !KeyOf wf-code-try }
    attrs: { order: 3, enabled: true, failure_result: true }
  - model: authentik_policies_expression.expressionpolicy
    id: wf-codes-paused
    identifiers: { name: workforce-codes-paused }
    attrs:
      name: workforce-codes-paused
      expression: |
{% filter indent(8, true) %}
{% include 'password-pause.py' %}
{% include 'code-tries.py' %}
{% endfilter %}
        # ---- the authentik part ----
        from datetime import datetime, timezone as tz
        from django.db import connections, transaction
        from django.utils import timezone
        http, person, account, conn, address = wf_ak_subject(request)
        pk = getattr(person, "pk", None)
        if pk is None:
            return False
        plan = request.context.get("flow_plan")
        with transaction.atomic(using="default"):
            with connections["default"].cursor() as cursor:
                wf_ak_lock(cursor, (WF_LOCK_CODES, "codes:%d" % int(pk)), (WF_LOCK_CODES, None))
            now = timezone.now().timestamp()
            since = datetime.fromtimestamp(now - 2 * WF_WINDOW, tz.utc)
            tries = [(at, c.get("wf_try")) for at, c in wf_ak_rows(WF_CODE_TRY, since, wf_user_pk=int(pk))]
            right = set(c.get("wf_try") for at, c in wf_ak_rows(WF_CODE_RIGHT, since, wf_user_pk=int(pk)))
            tid = plan.context.pop(WF_PLAN_CODE_TRY, None) if plan is not None else None
            marked = False
            if tid and tid in set(t for at, t in tries) and tid not in right:
                # Only reached at 31, after the code step accepted this code (at 29 no code has been typed yet).
                wf_ak_record(WF_CODE_RIGHT, WF_CODE_KEEP, address, wf_try=tid, wf_user_pk=int(pk))
                right.add(tid)
                marked = True
            paused = wf_codes_paused(tries, right, now) is not None
            if marked and not paused and wf_signs_in(person, plan):
                # A completed sign-in (contract R.2): the right password (23 let it past) and now the right code. It
                # makes this source proven, and with two other people's a workplace (R.4): never anything the browser
                # sends, and one person counts once however often they sign in.
                wf_ak_record(WF_SIGNED, WF_KEEP_SIGNED, address, person, wf_user_pk=int(pk), wf_conn=conn)
        return paused
  - model: authentik_stages_deny.denystage
    id: wf-too-many-tries-codes
    identifiers: { name: workforce-too-many-tries-codes }
    attrs:
      name: workforce-too-many-tries-codes
      deny_message: >-
        That code was wrong too many times. Wait 15 minutes, then sign in again, and we’ll send you a new code.
  - model: authentik_flows.flowstagebinding
    id: wf-too-many-tries-codes-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-too-many-tries-codes
    attrs:
      order: 29
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-too-many-tries-codes-binding, policy: !KeyOf wf-codes-paused }
    attrs: { order: 0, enabled: true, failure_result: true }

  # Third review of finding 6: the code step asks again in place, so the check at 29 isn't seen again. It is checked
  # once more after the code: after too many wrong codes, even a right code doesn't sign anyone in. (Not a lock on the
  # code step itself: a skipped code step would sign in without a code.)
  - model: authentik_stages_deny.denystage
    id: wf-too-many-tries-after-code
    identifiers: { name: workforce-too-many-tries-after-code }
    attrs:
      name: workforce-too-many-tries-after-code
      deny_message: >-
        That code was wrong too many times. Wait 15 minutes, then sign in again, and we’ll send you a new code.
  - model: authentik_flows.flowstagebinding
    id: wf-too-many-tries-after-code-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf wf-too-many-tries-after-code
    attrs:
      order: 31
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf wf-too-many-tries-after-code-binding, policy: !KeyOf wf-codes-paused }
    attrs: { order: 0, enabled: true, failure_result: true }

  # Second security review (finding 1): authentik's first-run page (initial-setup) sets akadmin's password with no
  # code. The flow itself is closed, as authentik closes it after its own setup: only a superuser may run it, and
  # every policy bound to it must pass. (A flow needs ANY of its policies by default, and authentik's own
  # default-oobe-password-usable passes on a fresh install, so a refusing policy alone did nothing: third review.)
  # Name, title and designation are restated as authentik's first-run blueprint has them, so this works whichever
  # of the two runs first. The gateway doesn't route the page and sign-in-hardening.py sets authentik's Setup flag.
  - model: authentik_flows.flow
    id: wf-first-run-flow
    identifiers: { slug: initial-setup }
    attrs:
      name: default-oobe-setup
      title: Welcome to authentik!
      designation: stage_configuration
      denied_action: message_continue
      authentication: require_superuser
      policy_engine_mode: all
    state: present
  - model: authentik_policies_expression.expressionpolicy
    id: wf-no-first-run
    identifiers: { name: workforce-no-first-run-page }
    attrs:
      name: workforce-no-first-run-page
      expression: |
        return False
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf wf-first-run-flow
      policy: !KeyOf wf-no-first-run
    attrs: { order: 0, enabled: true }
