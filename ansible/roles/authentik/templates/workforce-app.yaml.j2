version: 1
metadata:
  name: Workforce application
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Default - Authentication flow
      required: false
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Default - Invalidation flow
      required: false
  # ADR-0017: the invite claim. Written to the user's attributes from the invitation's fixed
  # data at enrolment (users cannot edit attributes); the app links the login to the invited
  # staff record by this id, never by email (authentik reports email_verified=true for all).
  # Sign-in, enrolment and sign-out pages look like Workforce, not authentik (ux-product-review
  # R5): the browser-tab title, logo and icon. The logo and icon are the app's public build-time
  # brand files (no tenant data); branding/authentik-custom.css does the page styling.
  - model: authentik_brands.brand
    identifiers:
      domain: authentik-default
    attrs:
      branding_title: Workforce
      branding_logo: https://{{ app_hostname }}/icons/wordmark.svg
      branding_favicon: https://{{ app_hostname }}/icons/icon.svg
      # branding/authentik-custom.css, mounted by compose.yaml; empty if the mount is missing.
      branding_custom_css: !File [/branding/authentik-custom.css, ""]
      attributes:
        settings:
          theme:
            base: light
  - model: authentik_providers_oauth2.scopemapping
    id: workforce-invite-scope
    identifiers:
      name: Workforce invite claim
    attrs:
      name: Workforce invite claim
      scope_name: workforce
      description: Links this login to the staff record it was invited for
      # authentik's user-write stage treats "_" in an attribute key as a path separator, so the
      # invitation's `attributes.workforce_invite` is stored as attributes.workforce.invite.
      expression: |
        return {"workforce_invite": (request.user.attributes.get("workforce") or {}).get("invite")}
  - attrs:
      name: Workforce
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_id: {{ oidc_client_id }}
      client_secret: {{ oidc_client_secret }}
      # Without a signing_key the provider publishes an EMPTY JWKS and
      # every id_token fails validation ("no matching key(s) found").
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: user_email
      access_token_validity: hours=1
      refresh_token_validity: days=30
      # One list, typed entries (authentik 2026.x model): post-logout returns
      # are NOT a separate field — post_logout_redirect_uris is derived from
      # redirect_uris entries whose redirect_uri_type is 'logout'. A top-level
      # post_logout key is silently dropped by the serializer (same failure
      # mode as the old launch_url typo — caught live on the 2026.8 upgrade).
      redirect_uris:
        - matching_mode: strict
          url: https://{{ app_hostname }}/login/oauth2/code/oidc
        # RP-Initiated Logout (#14): Spring's handler returns to {baseUrl}/
        # after end-session; strict matching must allow exactly that.
        - matching_mode: strict
          redirect_uri_type: logout
          url: https://{{ app_hostname }}/
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
        - !KeyOf workforce-invite-scope
    identifiers:
      name: Workforce
    state: present
    model: authentik_providers_oauth2.oauth2provider
    id: workforce-provider
  - attrs:
      name: Workforce
      slug: workforce
      # The portal tile takes the user INTO the app (which starts the OIDC
      # flow properly) — a tile without a launch URL lands on the provider's
      # authorize endpoint without parameters: "Invalid credentials".
      # NOTE: the blueprint field is meta_launch_url (launch_url is silently
      # ignored by the serializer — verified against an empty DB column).
      meta_launch_url: https://{{ app_hostname }}
      provider: !KeyOf workforce-provider
    identifiers:
      slug: workforce
    state: present
    model: authentik_core.application
  - attrs:
      username: admin
      name: Administrator
      type: internal
      is_active: true
      # NOT acme_email: in certs-mode test installs that is the placeholder
      # 'local-ca@invalid', which authentik's serializer rejects — a rejected
      # entry aborts the whole blueprint import (provider never created).
      email: admin@{{ auth_hostname }}
{% if ak_admin_password | default('') | length > 0 %}
      password: {{ ak_admin_password }}
{% endif %}
    identifiers:
      username: admin
    state: created
    model: authentik_core.user

  # ---------- ADR-0017: staff enrolment by invitation only ----------
  - model: authentik_stages_invitation.invitationstage
    id: wf-invitation-stage
    identifiers: { name: workforce-invitation }
    attrs:
      name: workforce-invitation
      continue_flow_without_invitation: false
  - model: authentik_stages_prompt.prompt
    id: wf-prompt-name
    identifiers: { name: workforce-enrollment-name }
    attrs:
      name: workforce-enrollment-name
      field_key: name
      label: Your full name
      type: text
      required: true
      placeholder: As your manager knows you
      order: 10
  - model: authentik_stages_prompt.prompt
    id: wf-prompt-password
    identifiers: { name: workforce-enrollment-password }
    attrs:
      name: workforce-enrollment-password
      field_key: password
      label: Choose a password
      type: password
      required: true
      placeholder: At least 10 characters
      order: 20
  - model: authentik_stages_prompt.prompt
    id: wf-prompt-password-repeat
    identifiers: { name: workforce-enrollment-password-repeat }
    attrs:
      name: workforce-enrollment-password-repeat
      field_key: password_repeat
      label: Type it again
      type: password
      required: true
      placeholder: The same password
      order: 30
  - model: authentik_policies_password.passwordpolicy
    id: wf-password-policy
    identifiers: { name: workforce-password-policy }
    attrs:
      name: workforce-password-policy
      password_field: password
      length_min: 10
      error_message: Use at least 10 characters.
      check_static_rules: true
      check_have_i_been_pwned: false
      check_zxcvbn: false
  - model: authentik_stages_prompt.promptstage
    id: wf-enrollment-prompt
    identifiers: { name: workforce-enrollment-prompt }
    attrs:
      name: workforce-enrollment-prompt
      fields:
        - !KeyOf wf-prompt-name
        - !KeyOf wf-prompt-password
        - !KeyOf wf-prompt-password-repeat
      validation_policies:
        - !KeyOf wf-password-policy
  - model: authentik_stages_user_write.userwritestage
    id: wf-enrollment-write
    identifiers: { name: workforce-enrollment-write }
    attrs:
      name: workforce-enrollment-write
      user_creation_mode: always_create
      create_users_as_inactive: false
      user_type: internal
  - model: authentik_stages_user_login.userloginstage
    id: wf-enrollment-login
    identifiers: { name: workforce-enrollment-login }
    attrs:
      name: workforce-enrollment-login
  - model: authentik_flows.flow
    id: wf-enrollment-flow
    identifiers: { slug: workforce-enrollment }
    attrs:
      name: Workforce enrolment
      slug: workforce-enrollment
      title: Set up your account
      designation: enrollment
      authentication: require_unauthenticated
      layout: stacked
  - model: authentik_flows.flowstagebinding
    identifiers: { target: !KeyOf wf-enrollment-flow, stage: !KeyOf wf-invitation-stage }
    attrs: { order: 10 }
  - model: authentik_flows.flowstagebinding
    identifiers: { target: !KeyOf wf-enrollment-flow, stage: !KeyOf wf-enrollment-prompt }
    attrs: { order: 20 }
  - model: authentik_flows.flowstagebinding
    identifiers: { target: !KeyOf wf-enrollment-flow, stage: !KeyOf wf-enrollment-write }
    attrs: { order: 30 }
  - model: authentik_flows.flowstagebinding
    identifiers: { target: !KeyOf wf-enrollment-flow, stage: !KeyOf wf-enrollment-login }
    attrs: { order: 40 }

  # ---------- Review R5: the sign-in page is ours, not authentik's ----------
  - model: authentik_flows.flow
    identifiers: { slug: default-authentication-flow }
    attrs:
      title: Sign in to Workforce
    state: present

  # ---------- ADR-0017: people cannot change their own email ----------
  - model: authentik_stages_prompt.promptstage
    identifiers: { name: default-user-settings }
    attrs:
      fields:
        - !Find [authentik_stages_prompt.prompt, [name, default-user-settings-field-username]]
        - !Find [authentik_stages_prompt.prompt, [name, default-user-settings-field-name]]
        - !Find [authentik_stages_prompt.prompt, [name, default-user-settings-field-locale]]

