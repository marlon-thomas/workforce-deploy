ENV_NAME={{ env_name }}
APP_HOSTNAME={{ app_hostname }}
AUTH_HOSTNAME={{ auth_hostname }}
ACME_EMAIL={{ acme_email }}
GATEWAY_IMAGE={{ gateway_image | default('caddy:2.8.4@sha256:226d1f059b75399fe19182893c7184591c07b97afc8dfcf44eeb80c9a77a530f', true) }}
GATEWAY_CADDYFILE={{ gateway_caddyfile | default('./gateway/Caddyfile', true) }}
DUCKDNS_API_TOKEN={{ duckdns_api_token | default('', true) }}

DB_NAME=workforce
DB_USER=workforce_app

MINIO_BUCKET=workforce-evidence

AK_DB_NAME=authentik
AK_DB_USER=authentik

OIDC_ISSUER=https://{{ auth_hostname }}/application/o/workforce/

API_IMAGE=ghcr.io/marlon-thomas/workforce-suite
APP_VERSION={{ app_version }}

# Outbound email (#6). SMTP_HOST empty => log-only mode (the honest default for
# appliances without a relay). COMPOSE_PROFILES=mail additionally runs the local
# mailpit catcher on the 'data' network (test appliance; never for prod).
SMTP_HOST={{ smtp_host | default('', true) }}
SMTP_PORT={{ smtp_port | default('587', true) }}
SMTP_USERNAME={{ smtp_username | default('', true) }}
# Quoted: a relay password may hold characters that would break .env for compose and bash.
SMTP_PASSWORD={{ smtp_password | default('', true) | quote }}
SMTP_STARTTLS={{ smtp_starttls | default('false', true) }}
SMTP_FROM={{ smtp_from | default('noreply@' ~ app_hostname, true) }}
# Sign-in codes and server alerts (Workforce ADR-0039): their own relay account, kept apart from the relay
# above that notifications and staff mail share. Empty SIGNIN_SMTP_HOST = they use SMTP_* too (doctor warns).
SIGNIN_SMTP_HOST={{ signin_smtp_host | default('', true) }}
SIGNIN_SMTP_PORT={{ signin_smtp_port | default('587', true) }}
SIGNIN_SMTP_USERNAME={{ signin_smtp_username | default('', true) }}
SIGNIN_SMTP_PASSWORD={{ signin_smtp_password | default('', true) | quote }}
SIGNIN_SMTP_STARTTLS={{ signin_smtp_starttls | default('false', true) }}
SIGNIN_SMTP_FROM={{ signin_smtp_from | default('', true) }}
NOTIFICATION_BASE_URL=https://{{ app_hostname }}
COMPOSE_PROFILES={{ compose_profiles | default('', true) }}

# Server alerts (bin/healthwatch.sh, every 15 minutes from the backup container): comma-separated
# addresses, no spaces, NOT hosted on this server, so they still arrive when its mail is down.
# Sent straight through SMTP_HOST. Empty = problems are only logged (logs/healthwatch.log).
OPS_ALERT_EMAIL={{ ops_alert_email | default('', true) }}
# Sender of the alerts; empty = SMTP_FROM.
OPS_ALERT_FROM={{ ops_alert_from | default('', true) }}
# Outside uptime check (RUNBOOK §7c): a ping URL (e.g. Healthchecks.io) the health watch calls every
# 15 minutes; the outside service emails you when the pings stop (server off, network down).
OPS_HEARTBEAT_URL={{ ops_heartbeat_url | default('', true) }}

# The app's name and logo for every organisation on this server (Workforce issue 332), set only here.
# BRAND_LOGO_FILE is a PNG or JPG in this bundle's branding/ folder; absent = Workforce's own mark.
BRAND_PRODUCT_NAME={{ brand_product_name | default('Workforce', true) | quote }}
BRAND_LOGO_FILE={{ brand_logo_file | default('logo.png', true) | quote }}

# AI services listed for testing only (ADR-0021 §6): test appliance only, never production.
AI_TEST_SERVICES={{ ai_test_services | default('false', true) }}
# The AI service for every organisation on this server (ADR-0021; README, "The AI assistant"). Empty
# AI_PROVIDER = none, and each organisation may set its own in Setup -> AI assistant. The key is
# secrets/ai_api_key, never here. Quoted: an endpoint, model or list must not break .env for compose
# and bash.
AI_PROVIDER={{ ai_provider | default('', true) | quote }}
AI_ENDPOINT={{ ai_endpoint | default('', true) | quote }}
AI_MODEL={{ ai_model | default('', true) | quote }}
AI_REGION={{ ai_region | default('', true) | quote }}
AI_LOCKED={{ ai_locked | default('false', true) | quote }}
AI_ALLOWED_PROVIDERS={{ ai_allowed_providers | default('', true) | quote }}
# On site only: AI machines on this network that organisations may choose. Never on the hosted platform.
AI_TRUSTED_ENDPOINTS={{ ai_trusted_endpoints | default('', true) | quote }}
# People we support is held back from the first release (Workforce issue 255): empty follows AI_TEST_SERVICES.
WORKFORCE_CARE_AVAILABLE={{ care_available | default('', true) }}

# The hosted platform (environments/hosted.env): true hides Server health and the jobs from Setup,
# whatever they say (Workforce issue 341). Each organisation has its own database there, so the app
# can't tell by itself.
WORKFORCE_HOSTED={{ hosted | default('false', true) }}

# Setup -> Server health (RUNBOOK §7b). Hidden on the hosted platform (above), and on a server whose
# database holds more than one organisation, whatever this says (Workforce issue 341); false hides it
# on a server with one organisation too.
WORKFORCE_SERVER_HEALTH_VISIBLE={{ server_health_visible | default('true', true) }}

# Routine jobs started from Setup: backups, staff email, the relay, alerts (RUNBOOK, "Jobs from the
# app"). WORKFORCE_SERVER_ACTIONS is the app's setting: the hosted platform sets false, and it's off
# whenever the one above is off. SERVER_ACTIONS=off stops the helper itself, whatever the app says.
WORKFORCE_SERVER_ACTIONS={{ server_actions_visible | default('true', true) }}
SERVER_ACTIONS={{ server_actions | default('on', true) }}
# Test appliance only: this one host:port may be used as the relay without STARTTLS (mailpit).
SERVER_ACTIONS_PLAIN_RELAY={{ server_actions_plain_relay | default('', true) }}

# The emergency administrator's recovery email (Workforce ADR-0026): an address the operator reads
# OUTSIDE this server — never a mailbox here (reading it needs the sign-in that is lost). Applied to
# the installer's Administrator (and authentik's akadmin) by ./bin/update.sh. Empty = unchanged.
ADMIN_RECOVERY_EMAIL={{ admin_recovery_email | default('', true) }}

# Reports from inside the app (feedback-spec.md): the installation's GitHub App. Not secrets —
# the App's private key goes in secrets/feedback_github_key. Empty app id = reports stay in-house.
FEEDBACK_INSTALLATION={{ feedback_installation | default(env_name, true) }}
FEEDBACK_GITHUB_REPO={{ feedback_github_repo | default('', true) }}
FEEDBACK_GITHUB_APP_ID={{ feedback_github_app_id | default('', true) }}
FEEDBACK_GITHUB_INSTALLATION_ID={{ feedback_github_installation_id | default('', true) }}
FEEDBACK_ENGINEER_LOGIN={{ feedback_engineer_login | default('', true) }}

# Staff email (mail-calendar-spec §11): written by ./bin/staff-mail.sh, and the relay by Setup -> Email.
# Empty MAIL_SERVER_URL = this installation has no staff email. When the installer runs again, these
# come back from .env, so it never turns staff email off. Quoted where a value is free text.
WEBMAIL_HOSTNAME={{ webmail_hostname | default('', true) }}
WEBMAIL_URL={{ webmail_url | default('', true) | quote }}
MAIL_HOSTNAME={{ mail_hostname | default('', true) }}
MAIL_SERVER_URL={{ mail_server_url | default('', true) | quote }}
MAIL_TLS_VERIFY={{ mail_tls_verify | default('', true) }}
MAIL_SIGN_IN_ALLOW_INVALID_CERTS={{ mail_sign_in_allow_invalid_certs | default('', true) }}
MAIL_RELAY_HOST={{ mail_relay_host | default('', true) | quote }}
MAIL_RELAY_PORT={{ mail_relay_port | default('', true) }}
MAIL_RELAY_USER={{ mail_relay_user | default('', true) | quote }}
MAIL_RELAY_IMPLICIT_TLS={{ mail_relay_implicit_tls | default('', true) }}
MAIL_RELAY_SPF_INCLUDE={{ mail_relay_spf_include | default('', true) | quote }}

BACKUP_TARGET={{ backup_target | default('') }}
# The public half of the age key off-site copies are encrypted to. The private half stays off this
# server. With a target and no usable recipient, nothing goes off-site (RUNBOOK).
BACKUP_ENCRYPT_RECIPIENT={{ backup_encrypt_recipient | default('') }}
DOCKER_SOCK={{ docker_sock | default('/var/run/docker.sock') }}
