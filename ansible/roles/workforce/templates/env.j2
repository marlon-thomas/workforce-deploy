ENV_NAME={{ env_name }}
APP_HOSTNAME={{ app_hostname }}
AUTH_HOSTNAME={{ auth_hostname }}
ACME_EMAIL={{ acme_email }}
GATEWAY_IMAGE={{ gateway_image | default('caddy:2.8.4', true) }}
GATEWAY_CADDYFILE={{ gateway_caddyfile | default('./gateway/Caddyfile', true) }}
DUCKDNS_API_TOKEN={{ duckdns_api_token | default('', true) }}

DB_NAME=workforce
DB_USER=workforce_app

MINIO_BUCKET=workforce-evidence

AK_DB_NAME=authentik
AK_DB_USER=authentik

OIDC_ISSUER=https://{{ auth_hostname }}/application/o/workforce/

API_IMAGE=ghcr.io/marlon-thomas/workforce-suite
APP_VERSION={{ app_version }}

# Outbound email (#6). SMTP_HOST empty => log-only mode (the honest default for
# appliances without a relay). COMPOSE_PROFILES=mail additionally runs the local
# mailpit catcher on the 'data' network (test appliance; never for prod).
SMTP_HOST={{ smtp_host | default('', true) }}
SMTP_PORT={{ smtp_port | default('587', true) }}
SMTP_USERNAME={{ smtp_username | default('', true) }}
SMTP_PASSWORD={{ smtp_password | default('', true) }}
SMTP_STARTTLS={{ smtp_starttls | default('false', true) }}
SMTP_FROM={{ smtp_from | default('noreply@' ~ app_hostname, true) }}
NOTIFICATION_BASE_URL=https://{{ app_hostname }}
COMPOSE_PROFILES={{ compose_profiles | default('', true) }}

# Reports from inside the app (feedback-spec.md): the installation's GitHub App. Not secrets —
# the App's private key goes in secrets/feedback_github_key. Empty app id = reports stay in-house.
FEEDBACK_INSTALLATION={{ feedback_installation | default(env_name, true) }}
FEEDBACK_GITHUB_REPO={{ feedback_github_repo | default('', true) }}
FEEDBACK_GITHUB_APP_ID={{ feedback_github_app_id | default('', true) }}
FEEDBACK_GITHUB_INSTALLATION_ID={{ feedback_github_installation_id | default('', true) }}
FEEDBACK_ENGINEER_LOGIN={{ feedback_engineer_login | default('', true) }}

BACKUP_TARGET={{ backup_target | default('') }}
DOCKER_SOCK={{ docker_sock | default('/var/run/docker.sock') }}
