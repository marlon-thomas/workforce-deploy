__pycache__/
*.pyc

# Appliance state — never committed (ADR-0010: no credentials in either repo).
# secrets/ holds generated credentials, the admin-password record, TLS keys.
secrets/*
!secrets/.gitkeep
.env
.env.*
!.env.example
backups/
logs/
state/
# The health watch's report to the app. Masked, but it is this server's, not the repo's.
status/*
!status/.gitkeep
inventories/local/

# Rendered by the identity converge (holds the OIDC client secret).
blueprints/workforce-app.yaml
