__pycache__/
*.pyc

# Appliance state — never committed (ADR-0010: no credentials in either repo).
# secrets/ holds generated credentials, the admin-password record, TLS keys.
secrets/*
!secrets/.gitkeep
.env
.env.*
!.env.example
backups/
logs/
state/
# The installation's own logo (BRAND_LOGO_FILE, Workforce issue 332): this server's, not the repo's.
branding/*.png
branding/*.jpg
branding/*.jpeg
# The health watch's report to the app. Masked, but it is this server's, not the repo's.
status/*
!status/.gitkeep
# The app's requests to the server and their results (bin/server-actions.sh). A request can hold a
# password for the moment before it is read. Never committed; backup.sh doesn't archive it.
actions/
inventories/local/

# Rendered by the identity converge (holds the OIDC client secret).
blueprints/workforce-app.yaml

# Signing keys never belong here: only the release key's public half, cosign.pub, is committed
# (Workforce issues 353 and 422). The private half stays in the source repository's release environment.
*.key
