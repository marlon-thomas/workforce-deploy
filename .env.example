# This file is a TEMPLATE. It intentionally contains NO real secrets.
# For production, copy to deploy/.env and supply secret values via ./deploy/secrets/* files.
#
# Non-secret configuration (this file):
DB_NAME=workforce
DB_USER=workforce_app
MINIO_BUCKET=care-angels-evidence
OIDC_ISSUER=https://auth.careangelssupport.com/application/o/care-angels/
AK_DB_NAME=authentik
AK_DB_USER=authentik
APP_VERSION=0.1.0

# Secrets (supply via ./secrets/* files, never in this file):
#   secrets/db_password          -> application database password (POSTGRES_PASSWORD_FILE + app)
#   secrets/minio_access         -> MinIO root access key
#   secrets/minio_secret         -> MinIO root secret key
#   secrets/oidc_client_id       -> authentik OAuth2 client id for the app
#   secrets/oidc_client_secret   -> authentik OAuth2 client secret
#   secrets/ak_db_password       -> authentik database password
#   secrets/ak_secret            -> authentik instance secret key (random, >=64 chars)
