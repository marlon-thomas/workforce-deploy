# This file is a TEMPLATE. It intentionally contains NO real values.
# Copy to deploy/.env and fill in YOUR organisation's values, then run:
#   docker compose -f deploy/compose.yaml up -d
# See deploy/README.md for the full from-scratch setup guide.

# ---- Hostnames (must resolve to this host; TLS is issued automatically) ----
APP_HOSTNAME=app.example.com
AUTH_HOSTNAME=auth.example.com
ACME_EMAIL=admin@example.com

# ---- Application images (pinned by install/update; deployment-spec §B1) ----
# The suite image carries api + worker + the compiled UI (frontend baked in).
# install.sh writes the pinned version into APP_VERSION; update.sh changes it.
API_IMAGE=ghcr.io/marlon-thomas/workforce-suite
APP_VERSION=latest
# Optional pull fallback if GHCR rate-limits this network (images mirrored to Docker Hub):
# DOCKERHUB_USER=yourhubuser

# Rootless Docker: the installer writes this automatically (host docker socket path).
# DOCKER_SOCK=/run/user/1000/docker.sock

# ---- Application database ----
DB_NAME=workforce
DB_USER=workforce_app
# DB_PASSWORD must be written to ./deploy/secrets/db_password (mode 600)

# ---- Object storage (MinIO) ----
# access/secret written to ./deploy/secrets/minio_access and minio_secret
MINIO_BUCKET=workforce-evidence

# ---- authentik (standalone IdP, bundled) ----
# Create the application in the authentik admin UI after first boot:
#   redirect URI: https://$APP_HOSTNAME/login/oauth2/code/oidc
# then put its issuer URL here (authentik shows it on the provider page).
OIDC_ISSUER=https://auth.example.com/application/o/<your-application-slug>/
# client id/secret written to ./deploy/secrets/oidc_client_id and oidc_client_secret

AK_DB_NAME=authentik
AK_DB_USER=authentik
# written to ./deploy/secrets/ak_db_password and ak_secret

# ---- Release ----
# API_IMAGE is required: the image name the api/worker/migration containers are
# built as and run from. No tag here — the tag comes from APP_VERSION below.
# Locally built (no registry needed): API_IMAGE=workforce-api
# From your own registry:          API_IMAGE=ghcr.io/marlon-thomas/workforce-suite
API_IMAGE=ghcr.io/marlon-thomas/workforce-suite
APP_VERSION=0.1.0
