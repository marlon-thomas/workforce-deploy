# --- Production Caddyfile (gateway service, spec §10.1) ---
# Terminates TLS, routes to internal services, applies security headers.
# Only ports 80/443 are published by the host. The compiled UI is served by
# `api`, so a single upstream handles everything.

{
	email admin@careangelssupport.com
	# Staging certs during initial validation; switch to production after validation.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

app.careangelssupport.com {
	reverse_proxy api:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
		-Server
	}
}

auth.careangelssupport.com {
	reverse_proxy authentik-server:9000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
