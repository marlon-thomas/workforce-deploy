# --- Test-environment Caddyfile (TLS_MODE=dns01) ---
# Same routing and headers as the production Caddyfile; certificates are
# issued via the DuckDNS API (DNS-01) instead of HTTP-01, so the appliance
# needs no inbound internet reachability. Requires the duckdns-enabled
# gateway image (GATEWAY_IMAGE) and DUCKDNS_API_TOKEN in the environment.

{
	email {$ACME_EMAIL}
	# Same issuer pin rationale as production: LE only, no ZeroSSL fallback.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	# DNS-01 via the DuckDNS API. Works for every <name>.duckdns.org hostname
	# under the account token; no A records are needed for issuance.
	acme_dns duckdns {$DUCKDNS_API_TOKEN}
}

{$APP_HOSTNAME} {
	# Asked only by the sign-in server on the private network (staff webmail); never from outside.
	respond /api/public/mail/* 404
	# While the appliance controller installs an update (Workforce slice 3b), users are kept out until the new
	# version has passed its health check, so a rollback never undoes what they did: the controller puts a file
	# `on` in this folder (its own, mounted read-only by compose.controller.yaml) and removes it once the update
	# has succeeded or been rolled back. Read at each request, so no reload. The version endpoint stays open for
	# the health check. On the host layout the folder isn't there, and nothing changes.
	@updating {
		file {
			root /etc/caddy/maintenance
			try_files /on
		}
		not path /api/v1/build-meta
	}
	header @updating Retry-After 120
	respond @updating "Workforce is being updated. Please try again in a few minutes." 503
	reverse_proxy api:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' blob:; frame-ancestors 'none'"
		-Server
	}
}

{$AUTH_HOSTNAME} {
	# While the appliance controller installs an update (Workforce issue 453), the sign-in pages are kept out too, from the
	# moment the application stops until the update has succeeded or been rolled back: a rollback puts the sign-in
	# server's database back, so a password changed or an account switched off here meanwhile would be silently undone.
	# Open still: what the application, webmail's mail server and the health check read (discovery, the signing keys,
	# authentik's own health), none of which changes anything. The same switch as the application's site.
	@signin_updating {
		file {
			root /etc/caddy/maintenance
			try_files /on
		}
		not path /application/o/workforce/.well-known/openid-configuration /application/o/workforce/jwks/ /application/o/webmail/.well-known/openid-configuration /application/o/webmail/jwks/ /-/health/ready/ /-/health/live/
	}
	header @signin_updating Retry-After 120
	respond @signin_updating "Workforce is being updated. Please try again in a few minutes." 503
	# Workforce ADR-0039 (security review): from outside, nobody removes or changes a sign-in code method through
	# authentik's own pages or API (Workforce does that on the private network, after its own checks), and
	# authentik's first-run page is never reachable.
	@code_methods {
		path /api/v3/authenticators/*
		not method GET HEAD
	}
	respond @code_methods "Change how you get sign-in codes in Workforce: My record, then Signing in." 403
	respond /setup* 404
	respond /if/flow/initial-setup* 404
	respond /api/v3/flows/executor/initial-setup* 404
	reverse_proxy authentik-server:9000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Staff webmail (COMPOSE_PROFILES=staffmail; mail-calendar-spec §11). Its own host name, never a
# path of the app: email is untrusted HTML, so webmail must not share the app's origin.
# WEBMAIL_HOSTNAME unset = webmail.localhost, a local-only name with an internal certificate.
{$WEBMAIL_HOSTNAME:webmail.localhost} {
	reverse_proxy webmail:80 {
		header_up X-Forwarded-Proto {scheme}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
