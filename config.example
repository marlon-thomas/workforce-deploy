# Copy this file to ./deploy/.env and fill with REAL secrets for production.
# Non-secret configuration may live here; secrets MUST come from ./deploy/secrets/* (Docker secrets).
# NEVER commit .env or ./secrets to source control.

# ---- Application database ----
DB_NAME=careangels
DB_USER=careangels_app
# DB_PASSWORD must be written to ./deploy/secrets/db_password (mode 600)

# ---- Object storage (MinIO) ----
# access/secret written to ./deploy/secrets/minio_access and minio_secret
MINIO_BUCKET=evidence

# ---- authentik (standalone IdP) ----
OIDC_ISSUER=https://auth.careangelssupport.com/application/o/care-angels/
# client id/secret written to ./deploy/secrets/oidc_client_id and oidc_client_secret

AK_DB_NAME=authentik
AK_DB_USER=authentik
# written to ./deploy/secrets/ak_db_password and ak_secret

# ---- Release ----
APP_VERSION=0.1.0
