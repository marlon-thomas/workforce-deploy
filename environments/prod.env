# Production environment defaults (deployment-spec §B, environments-design §2)
ENV_NAME=prod
BASE_DOMAIN=careangelssupport.com
APP_SUBDOMAIN=workforce
AUTH_SUBDOMAIN=auth
# derived: APP_HOSTNAME=workforce.careangelssupport.com / AUTH_HOSTNAME=auth.…
TLS_MODE=production

# Production pin — bump deliberately (update.sh on each appliance, then this
# line for fresh installs).
APP_VERSION=0.2.14
# The release tag of THIS repo production runs from (G-38). deploy_to_prod.py
# refuses to run without it — see RUNBOOK.md, "Cutting a production release".
# DEPLOY_REF=v1.0.0

# Server alerts (bin/healthwatch.sh, every 15 minutes): who OUTSIDE this server hears when it has a
# problem. Comma-separated, no spaces. It MUST be an address NOT hosted on this server — not the
# staff mail domain, nothing this server's Stalwart delivers — e.g. the operator's own provider, so
# alerts still arrive when this server's mail is what is broken. Alerts are sent straight through
# SMTP_HOST, which must be set too. Empty = problems are only logged on the box.
OPS_ALERT_EMAIL=
# OPS_ALERT_FROM=      (the sender; default SMTP_FROM)
# Outside uptime check (RUNBOOK §7c): a free service such as Healthchecks.io that expects a ping
# every 15 minutes and emails you when they stop — the only alert that still works when this server
# is switched off. Paste the check's ping URL. Pair it with an outside monitor of the public address.
OPS_HEARTBEAT_URL=

# AI services listed for testing only (ADR-0021 §6) must never be offered in production.
AI_TEST_SERVICES=false

# Setup -> Server health shows the health watch's results to the registered manager, director and
# data administrator (RUNBOOK §7b). true for a server that runs one organisation. The hosted
# platform, with several organisations on one server, sets this to false: a tenant must not see
# server details, and Setup status then says only what is configured.
WORKFORCE_SERVER_HEALTH_VISIBLE=true

# The emergency administrator's recovery email (Workforce ADR-0026). Set it before go-live to an
# address the operator controls that is NOT hosted on this server — not the staff mail domain, not
# this server's own names: a locked-out administrator cannot sign in to read mail here. Applied to
# the installer's Administrator (and authentik's akadmin) by install.sh and ./bin/update.sh; on an
# existing box add the line to its .env (update.sh does not re-render .env). doctor.sh warns while
# it is empty.
ADMIN_RECOVERY_EMAIL=
