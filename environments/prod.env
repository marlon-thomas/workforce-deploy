# Production environment defaults (deployment-spec §B, environments-design §2)
ENV_NAME=prod
BASE_DOMAIN=careangelssupport.com
APP_SUBDOMAIN=workforce
AUTH_SUBDOMAIN=auth
# derived: APP_HOSTNAME=workforce.careangelssupport.com / AUTH_HOSTNAME=auth.…
TLS_MODE=production

# Production pin — bump deliberately (update.sh on each appliance, then this
# line for fresh installs).
APP_VERSION=0.2.14
# The release tag of THIS repo production runs from (G-38). deploy_to_prod.py
# refuses to run without it — see RUNBOOK.md, "Cutting a production release".
# DEPLOY_REF=v1.0.0

# Server alerts (bin/healthwatch.sh, every 15 minutes): who OUTSIDE this server hears when it has a
# problem. Comma-separated, no spaces. It MUST be an address NOT hosted on this server — not the
# staff mail domain, nothing this server's Stalwart delivers — e.g. the operator's own provider, so
# alerts still arrive when this server's mail is what is broken. Alerts are sent straight through
# SMTP_HOST, which must be set too. Empty = problems are only logged on the box.
OPS_ALERT_EMAIL=
# OPS_ALERT_FROM=      (the sender; default SMTP_FROM)

# AI services listed for testing only (ADR-0021 §6) must never be offered in production.
AI_TEST_SERVICES=false
