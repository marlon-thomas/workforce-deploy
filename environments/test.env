# Test environment (Vagrant appliance on any host OS)
ENV_NAME=test
BASE_DOMAIN=workforce-test.duckdns.org
APP_SUBDOMAIN=app
AUTH_SUBDOMAIN=auth
# derived: APP_HOSTNAME=app.workforce-test.duckdns.org / AUTH_HOSTNAME=auth.…
# TLS_MODE dns01 (Let's Encrypt via DuckDNS API, no router config)
# is designed (environments-design.md §4) but not yet implemented;
# today the appliance runs --smoke (HTTP) or needs router port-forward.
TLS_MODE=dns01
DUCKDNS_TOKEN_FILE=~/.config/workforce-dev/duckdns.env
VAGRANT_MEM=4096
VAGRANT_CPUS=2
