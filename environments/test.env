# Test environment (Vagrant appliance on any host OS)
# Prod-like authentik OIDC, but TLS uses a LOCAL private CA — never a public
# certificate. See environments-design.md §4 / bin/gen-test-ca.sh.
# DuckDNS still provides the name->tailnet-IP glue (two names registered:
# workforce-test / workforce-test-auth); it just no longer issues certs.
ENV_NAME=test
BASE_DOMAIN=duckdns.org
WF_SUBDOMAIN=workforce-test
AUTH_SUBDOMAIN=workforce-test-auth
# derived: APP_HOSTNAME=workforce-test.duckdns.org
#          AUTH_HOSTNAME=workforce-test-auth.duckdns.org
# certs = workstation's private CA leaf (no ACME, no rate limits, tailnet-only).
TLS_MODE=certs
# Host dir (outside the repo/public bundle) holding ca.crt, tls.crt, tls.key.
# Created by ./bin/gen-test-ca.sh on the workstation.
TLS_CA_DIR=~/.config/workforce-dev/testca
# Path INSIDE the VM where bootstrap.py drops the host's token file
# (~/.config/workforce-dev/duckdns.env). Contains DUCKDNS_TOKEN=...
DUCKDNS_TOKEN_FILE=/home/vagrant/duckdns.env
VAGRANT_MEM=4096
VAGRANT_CPUS=2

# Pinned suite version for FRESH installs (existing deployments change only via
# bin/update.sh). Bumped automatically by the private-source publish workflow
# (ADR-0010); prod is bumped deliberately by a human.
APP_VERSION=0.2.45
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=workforce-test@workforce-test.duckdns.org
COMPOSE_PROFILES=mail
