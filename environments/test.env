# Test environment (Vagrant appliance on any host OS)
# Prod-like: full authentik OIDC + real Let's Encrypt certificates.
#   TLS via DuckDNS API (DNS-01): cert issuance needs NO inbound internet —
#   Tailscale provides reachability instead (environments-design.md §4).
# DuckDNS model: one A record per registered name, so the two hostnames are
# two DuckDNS names (already registered): workforce-test / workforce-test-auth.
ENV_NAME=test
BASE_DOMAIN=duckdns.org
WF_SUBDOMAIN=workforce-test
AUTH_SUBDOMAIN=workforce-test-auth
# derived: APP_HOSTNAME=workforce-test.duckdns.org
#          AUTH_HOSTNAME=workforce-test-auth.duckdns.org
TLS_MODE=dns01
# Path INSIDE the VM where bootstrap.py drops the host's token file
# (~/.config/workforce-dev/duckdns.env). Contains DUCKDNS_TOKEN=...
DUCKDNS_TOKEN_FILE=/home/vagrant/duckdns.env
VAGRANT_MEM=4096
VAGRANT_CPUS=2
