# The hosted platform (Workforce ADR-0008): we run the stack, with one database per organisation and
# the api choosing the database by hostname. This profile goes on top of prod.env, and holds only what
# differs from a server an organisation runs for itself. No hostnames or secrets here.

# Server health and the jobs from Setup are the server's, not a tenant's (Workforce issue 341). Each
# organisation has its own database here, so the app can't tell by counting organisations that the
# server is shared: this says so, and hides them whatever the settings below say.
WORKFORCE_HOSTED=true
WORKFORCE_SERVER_HEALTH_VISIBLE=false
WORKFORCE_SERVER_ACTIONS=false
SERVER_ACTIONS=off
